      "fileName": "untrained-improvisation.json",
      "id": "9jGaBxLUtevZYcZO",
      "name": "Untrained Improvisation",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "9jGaBxLUtevZYcZO",
        "folder": "Ak9gc6BXJUsrBm7q",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Untrained Improvisation",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "general",
          "description": {
            "value": "<p>You've learned how to handle situations when you're out of your depth. Your proficiency bonus to untrained skill checks is equal to your level –2. This improves to your level –1 at 5th level and your full level at 7th level. This doesn't allow you to use the skill's trained actions.</p>"
          },
          "level": {
            "value": 3
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "selector": "skill-check",
              "type": "proficiency",
              "value": "@actor.level + clamp(-2,floor((@actor.level - 7) / 2),0)"
            }
          ],
          "traits": {
            "rarity": "common",
