      "id": "yTLGclKtWVFZLKIz",
      "name": "Robust Health",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "yTLGclKtWVFZLKIz",
        "folder": "Ak9gc6BXJUsrBm7q",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Robust Health",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "general",
          "description": {
            "value": "<p>Your physiology responds well to first aid. You gain a circumstance bonus to the number of Hit Points you regain equal to your level from a successful attempt to @UUID[Compendium.pf2e.actionspf2e.Item.Treat Wounds]{Treat your Wounds} or use @UUID[Compendium.pf2e.feats-srd.Item.Battle Medicine] on you. After you or an ally use Battle Medicine on you, you become temporarily immune to that Battle Medicine for only 1 hour, instead of 1 day.</p>"
          },
          "level": {
            "value": 3
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "predicate": [
                {
                  "or": [
                    "action:battle-medicine",
                    "action:treat-wounds"
                  ]
                }
              ],
              "selector": "healing-received",
              "type": "circumstance",
              "value": "@actor.level"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "general"
            ]
          }
        },
        "type": "feat"
      },
      "level": 3,
