        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "general",
          "description": {
            "value": "<p>Your blood carries permanent regenerative properties. The penalties from @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled] and the penalties and lost HP from @UUID[Compendium.pf2e.conditionitems.Item.Drained] both affect you as if the condition values were 1 lower than they actually are. You also gain resistance 5 to persistent bleed damage and reduce the DC of checks to recover from persistent bleed damage to 11, or 6 if you have particularly effective assistance.</p>"
          },
          "level": {
            "value": 11
          },
          "prerequisites": {
            "value": [
              {
                "value": "Constitution +4"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder #213: Thirst for Blood"
          },
