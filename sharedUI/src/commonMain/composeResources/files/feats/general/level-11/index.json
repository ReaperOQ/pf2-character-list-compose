        "name": "A Home in Every Port",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "general",
          "description": {
            "value": "<p>You have a reputation in towns and villages you've visited, and residents are always willing to open their doors to you.</p>\n<p>When in a town or village, during downtime, you can spend 8 hours to locate a resident willing to provide lodging for you and up to six allies for up to 24 hours at no charge. The standard of living within the acquired lodging is comfortable, and square meals are provided at no cost.</p>\n<p>After 24 hours, you must pay standard prices for further lodging and meals or use this feat again to find a new resident willing to host you.</p>"
          },
          "level": {
            "value": 11
          },
          "prerequisites": {
            "value": [
              {
                "value": "Charisma +3"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "downtime",
              "general"
            ]
          }
        },
        "type": "feat"
      },
      "level": 11,
      "category": "general"
