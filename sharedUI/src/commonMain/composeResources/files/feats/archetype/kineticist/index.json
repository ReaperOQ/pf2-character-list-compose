    {
      "fileName": "improved-elemental-blast.json",
      "id": "8VlGHrDKjlY69jFv",
      "name": "Improved Elemental Blast",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "8VlGHrDKjlY69jFv",
        "folder": "WHfL9Rfh3txexT7Q",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Improved Elemental Blast",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>The power of your elemental blast improves. The damage of your elemental blast increases by one die.</p>\n<hr />\n<p><strong>Special</strong> You can take Improved Elemental Blast a second time at 14th level to increase your Elemental Blast to three damage die, and a third time at 18th level to increase your Elemental Blast to four damage die.</p>"
          },
          "level": {
            "value": 8
          },
          "maxTakable": 3,
          "prerequisites": {
            "value": [
              {
                "value": "Kineticist Dedication"
              }
            ]
          },
          "publication": {
            "license": "OGL",
            "remaster": true,
            "title": "Pathfinder Rage of Elements"
          },
          "rules": [
            {
              "key": "DamageAlteration",
              "mode": "upgrade",
              "property": "dice-number",
              "selectors": [
                "elemental-blast-damage"
              ],
              "slug": "base",
              "value": "1 + min(3,@item.timesTaken)"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
      "category": "class"
