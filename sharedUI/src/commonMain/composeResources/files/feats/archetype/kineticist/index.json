        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Through the Gate",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You gain a 1st- or 2nd-level kineticist feat of your choice. Your options include impulse feats for your kinetic element, as normal for a kineticist.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Kineticist Dedication"
              }
            ]
          },
          "publication": {
            "license": "OGL",
            "remaster": true,
            "title": "Pathfinder Rage of Elements"
          },
          "rules": [
            {
              "adjustName": false,
              "choices": {
                "filter": [
                  "item:category:class",
                  "item:trait:kineticist",
                  {
                    "lte": [
                      "item:level",
                      2
                    ]
                  },
                  {
                    "or": [
                      {
                        "not": "item:trait:impulse"
                      },
                      "item:trait:{actor|flags.system.kineticist.gate.one}",
                      "item:trait:{actor|flags.system.kineticist.gate.two}"
                    ]
                  }
                ],
                "itemType": "feat"
              },
