    {
      "fileName": "kineticist-dedication.json",
      "id": "CbfszeYw3cf99kdv",
      "name": "Kineticist Dedication",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "CbfszeYw3cf99kdv",
