    {
      "fileName": "posse.json",
      "id": "N0YcU8mIJnQ4C2N6",
      "name": "Posse",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "N0YcU8mIJnQ4C2N6",
        "folder": "JWly0XSuudv3BkAo",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Posse",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You have designated prey with Hunt Prey.</p><hr /><p>By spending 1 minute giving guidance to help hunt down your prey, you instruct up to five willing creatures to assist you. They gain a +1 circumstance bonus to @UUID[Compendium.pf2e.actionspf2e.Item.Seek] your prey, to @UUID[Compendium.pf2e.actionspf2e.Item.Track] your prey, and to @UUID[Compendium.pf2e.actionspf2e.Item.Gather Information] about your prey. You and the creatures assisting you gain a +1 circumstance bonus to initiative rolls when entering combat with your prey.</p>\n<p>These benefits lasts until you designate a new prey or your prey dies, whichever comes first. An individual creature assisting you loses this benefit if they're out of your presence for too long to benefit from your instructions. This is usually 1 hour, but is determined by the GM.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Bounty Hunter Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
