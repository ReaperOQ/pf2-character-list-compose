    {
      "fileName": "one-with-the-spirits.json",
      "id": "OxdlGZ1rndxalf6X",
      "name": "One with the Spirits",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "OxdlGZ1rndxalf6X",
        "folder": "KW2DgPiGHpnsrbtp",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "One with the Spirits",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per hour</p>\n<p><strong>Requirements</strong> You're under the effects of Enter Spirit Trance.</p><hr /><p>The spirits you've invoked throughout your life have left behind echoes and spiritual fragments, which you can manifest across your own flesh, temporarily transforming you into something more akin to spirit than mortal. For 1 minute, you gain fast healing 5 and you become @UUID[Compendium.pf2e.conditionitems.Item.Concealed]. You can't use this concealment to Hide. Your Strikes gain the benefits of a ghost touch property rune. Whenever you deal damage with a Strike, you can choose to have that Strike deal spirit damage, rather than its usual damage type.</p>\n<p>If you would be knocked @UUID[Compendium.pf2e.conditionitems.Item.Unconscious] or your dying value would increase while One with the Spirits is active, the spirits revive you at the beginning of your next turn, restoring you to 30 Hit Points. One with the Spirits then immediately ends.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT1H"
          },
          "level": {
            "value": 16
          },
          "prerequisites": {
            "value": [
              {
                "value": "Rivethun Invoker Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Divine Mysteries"
          },
          "rules": [],
