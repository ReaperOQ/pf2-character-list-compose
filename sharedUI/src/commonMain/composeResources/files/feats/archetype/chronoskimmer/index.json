                "chronoskimmer-dedication:stabilize"
              ],
              "required": true,
              "selector": "initiative",
              "value": 10
            },
            {
              "effectType": "fortune",
              "key": "SubstituteRoll",
              "label": "PF2E.SpecificRule.Chronoskimmer.DestabilizeSuccessLabel",
              "predicate": [
                "chronoskimmer-dedication:destabilize-success"
