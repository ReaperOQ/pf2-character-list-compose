    {
      "fileName": "borrow-time.json",
      "id": "6IrNSD0G5AAXPTJq",
      "name": "Borrow Time",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "6IrNSD0G5AAXPTJq",
        "folder": "C8Vz7YTmccUYDy6L",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Borrow Time",
        "system": {
          "actionType": {
            "value": "free"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per minute</p>\n<p><strong>Trigger</strong> Your turn begins.</p><hr /><p>You reach ahead and make use of time that's yet to be. You become @UUID[Compendium.pf2e.conditionitems.Item.Quickened] and can use the extra action to Step, Stride, or Strike. You gain this extra action immediately and can use it this turn. At the end of your turn, you become @UUID[Compendium.pf2e.conditionitems.Item.Stunned]{Stunned 1}.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT1M"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Chronoskimmer Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
