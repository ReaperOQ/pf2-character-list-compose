    {
      "fileName": "steal-time.json",
      "id": "UCFGUbmDnzRGmN9I",
      "name": "Steal Time",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "UCFGUbmDnzRGmN9I",
        "folder": "C8Vz7YTmccUYDy6L",
