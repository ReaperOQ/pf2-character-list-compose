          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature you're aware of critically succeeds on a Strike against you and would deal damage to you.</p>\n<p><strong>Frequency</strong> once per 10 minutes</p><hr /><p>You dramatically cry out in poetic verse about the tragedies that led to your doom at this very moment, instilling guilt in your attacker. The Strike deals normal damage rather than critical damage as your foe relents on their attack at the last moment as they're moved by your words, though other effects that happen on a critical hit still occur. The creature that made the triggering Strike must then succeed on a @Check[will|against:class] save against your Class DC or be @UUID[Compendium.pf2e.conditionitems.Item.Slowed]{Slowed 1} for 1 round by guilt at its actions against you.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT10M"
          },
