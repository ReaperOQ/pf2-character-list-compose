    {
      "fileName": "precious-ammunition.json",
      "id": "MlxfNv98LZKfYl64",
      "name": "Precious Ammunition",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "MlxfNv98LZKfYl64",
        "folder": "tRecoenlUx637wGV",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Precious Ammunition",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You have learned to mimic the power that lies between magic and material. You enchant a piece of ammunition on your person with the magical essence of a precious material, allowing you to leverage certain creatures' weaknesses.</p>\n<p>Choose cold iron or silver; if you shoot the arrow or bolt before the end of your turn, it counts as that material. At 14th level, add adamantine to the list of materials you can choose from.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
