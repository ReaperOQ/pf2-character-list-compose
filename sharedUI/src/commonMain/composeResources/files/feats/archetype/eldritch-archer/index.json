    {
      "fileName": "magic-ammunition.json",
      "id": "vUFvcrvszXlHvz2Y",
      "name": "Magic Ammunition",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "vUFvcrvszXlHvz2Y",
        "folder": "tRecoenlUx637wGV",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Magic Ammunition",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You imbue your ammunition with raw and potent magic, transforming it to suit your needs in any situation.</p>\n<p>When you select this feat, choose three types of common magical ammunition of 4th level or lower from <em>GM Core</em> or this book. Your GM might allow you to choose from other types of magical ammunition of an appropriate level, such as uncommon ammunition, or ammunition from other books. You gain the @UUID[Compendium.pf2e.actionspf2e.Item.Transform Ammunition] action.</p><hr /><p><strong>Special</strong> You can select this feat multiple times. Each time you do, select three additional types of magical ammunition as described above.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "round",
            "value": 1
          },
          "level": {
            "value": 8
          },
          "maxTakable": null,
          "prerequisites": {
