      "name": "Poisoner's Twist",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "pKoW1X95LjmWn5Jq",
        "folder": "0CCvmxP0UKs17wzC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Poisoner's Twist",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> Your last action was a successful melee Strike that dealt damage against a target afflicted by a poison, and you know which poison.</p>\n<p>Poisons attack specific parts of the body—one venom might target the lungs, another the circulatory system, while another deteriorates the nerves. You know how to take advantage of such weaknesses. You deal @Damage[1d6[untyped]] damage of the required Strike's damage type and @Damage[1d6[poison]] damage to the target. If you're at least 18th level, you deal @Damage[2d6[untyped]] damage of each type.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
