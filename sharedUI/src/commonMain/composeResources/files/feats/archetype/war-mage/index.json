    {
      "fileName": "mages-field-dressing.json",
      "id": "buUSr6Dh9md9WqJx",
      "name": "Mage's Field Dressing",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "buUSr6Dh9md9WqJx",
        "folder": "h3LLD3BmWA4ndNhV",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Mage's Field Dressing",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> Your previous action was to Cast a Spell from a wizard spell slot, and the spell affected an ally within 60 feet.</p><hr /><p>As your spell takes hold on your ally, you use some of its magic to quickly dress their wounds. You use @UUID[Compendium.pf2e.feats-srd.Item.Battle Medicine] on one ally affected by the required spell. You do not need to be holding or wearing a @UUID[Compendium.pf2e.equipment-srd.Item.Healer's Toolkit], as you conjure glowing threads, bandages, or similar supplies out of pure magic, which adds the arcane trait to Battle Medicine.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "War Mage Dedication"
              },
              {
                "value": "Battle Medicine"
              }
            ]
          },
