    {
      "fileName": "play-to-the-crowd.json",
      "id": "KrYvJ5n06yHCipCZ",
      "name": "Play to the Crowd",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "KrYvJ5n06yHCipCZ",
        "folder": "y6KtcXHQ6HCC9Am2",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Play to the Crowd",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> You reduce an enemy to 0 Hit Points during a non-trivial combat encounter with spectators.</p><hr /><p>You show off for the crowd. Attempt a @Check[performance] check; the DC is determined by the GM but is typically the standard DC for your level or the DC to @UUID[Compendium.pf2e.actionspf2e.Item.Make an Impression] on the spectators, whichever is higher. On a success, choose one of the following benefits; on a critical success, choose two benefits:</p><ul><li><p>A number of temporary Hit Points equal to your character level; these last for 1 minute.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Play to the Crowd (Temporary Hit Points)]</p></li><li><p>A +1 circumstance bonus to AC until the end of your next turn.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Play to the Crowd (AC Bonus)]</p></li><li><p>A +1 circumstance bonus to your next attack roll before the end of your next turn.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Play to the Crowd (Attack Roll Bonus)]</p></li></ul>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Gladiator Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
