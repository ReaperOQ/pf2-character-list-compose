      "data": {
        "_id": "OxvZSFGOjGfcSCv8",
        "folder": "fADia4PkBNaCxIP6",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Aeon Resonance",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You gain the resonant power of one embedded aeon stone as if it were placed in a @UUID[Compendium.pf2e.equipment-srd.Item.Wayfinder]. While you can embed multiple aeon stones in your flesh, you can gain the resonance power from only one embedded stone at a time, selected each day when you make your daily preparations.</p><hr /><p><strong>Special</strong> At 8th level, you can take this feat again. If you do, you gain the resonance powers of up to four invested aeon stones instead of only one.</p><hr /><p><em>PFS Note:</em> This feat acts as if an aeon stone was embedded in a <em>wayfinder</em>, and thus would not allow a second aeon stone to provide its resonance power from being embedded in a <em>wayfinder</em>.</p>"
          },
          "level": {
            "value": 4
          },
          "maxTakable": 2,
          "prerequisites": {
            "value": [
              {
                "value": "Embed Aeon Stone"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Rival Academies"
          },
