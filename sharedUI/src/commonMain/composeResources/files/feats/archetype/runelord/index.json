    {
      "fileName": "rod-of-rule.json",
      "id": "ZELjVKOohGw3ECwB",
      "name": "Rod of Rule",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "ZELjVKOohGw3ECwB",
        "folder": "fADia4PkBNaCxIP6",
