    {
      "fileName": "sin-counterspell.json",
      "id": "xblAUCASehLA9fbc",
      "name": "Sin Counterspell",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "xblAUCASehLA9fbc",
        "folder": "fADia4PkBNaCxIP6",
