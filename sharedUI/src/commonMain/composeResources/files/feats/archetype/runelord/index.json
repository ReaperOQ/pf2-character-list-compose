        "name": "Sin Counterspell",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>Your deep connection to a specific sin allows you to easily negate spells that sin opposes. Instead of being able to counter a foe's spell with Counterspell only if you have the same spell prepared, you can Counterspell it with any of your curriculum spells if the spell cast would violate your sin's anathema.</p>"
          },
          "level": {
            "value": 10
