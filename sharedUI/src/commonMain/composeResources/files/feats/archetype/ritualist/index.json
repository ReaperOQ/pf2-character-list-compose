    {
      "fileName": "efficient-rituals.json",
      "id": "jYKKnr41OqQrf7hv",
      "name": "Efficient Rituals",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "jYKKnr41OqQrf7hv",
        "folder": "YApBwwEEYNc1Xif0",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Efficient Rituals",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You can perform particularly extensive rituals in less time. If the ritual normally requires 1 day to cast, you can cast it in 4 hours. If it takes longer than 1 day, you cast it in half the number of days, rounded up.</p>\n<p>At 14th level, if a ritual has a casting time measured in days, you can cast it in an equal number of hours. If this results in a ritual longer than 8 hours, you split the ritual between multiple days, as normal for a ritual.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "Ritualist Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
