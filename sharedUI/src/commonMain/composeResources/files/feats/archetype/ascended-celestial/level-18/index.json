    {
      "fileName": "army-of-one.json",
      "id": "0UhZ3UtSXx9qyoiZ",
      "name": "Army of One",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "0UhZ3UtSXx9qyoiZ",
        "folder": "zuiUcpN5o6pf4AJw",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Army of One",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 3
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> Your nimbus is active.</p><hr /><p>Even alone, you're a force to be reckoned with—an army of one, so long as you have your celestial armaments. Spend 1 Mythic Point. If you're not currently wielding your celestial armament, it immediately teleports into your hand. With a gesture and a whispered prayer, you launch your celestial armament into the air, where it flies with a mind of its own, attacking every enemy within your nimbus. Make a Strike with that weapon against each enemy in the bright light of your nimbus. Each attack counts toward your multiple attack penalty, but your penalty doesn't increase until you have made all your attacks. After these attacks are complete, your weapon returns to your hand.</p>"
          },
          "level": {
            "value": 18
          },
          "prerequisites": {
            "value": [
              {
                "value": "Ascended Celestial Dedication"
              },
              {
                "value": "Celestial Armaments"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder War of Immortals"
          },
          "rules": [],
          "traits": {
            "rarity": "uncommon",
            "value": [
              "concentrate",
              "flourish",
              "mythic"
            ]
          }
        },
        "type": "feat"
      },
      "level": 18,
      "category": "class"
    },
    {
