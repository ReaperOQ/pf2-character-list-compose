              "mode": "add",
              "path": "flags.system.exemplar.archetypeFeatCount",
              "value": 1
            },
            {
              "key": "GrantItem",
              "uuid": "Compendium.pf2e.classfeatures.Item.Divine Spark and Ikons"
            },
            {
              "adjustName": false,
              "choices": [
                {
                  "label": "PF2E.AbilityStr",
                  "value": "str"
                },
                {
