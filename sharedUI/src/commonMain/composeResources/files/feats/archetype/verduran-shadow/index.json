    {
      "fileName": "sense-the-strike.json",
      "id": "h85DAkAPGjRFwIuf",
      "name": "Sense the Strike",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "h85DAkAPGjRFwIuf",
        "folder": "mLlFlndFIxI0g6U0",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Sense the Strike",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature targets you with an attack and you can see the attacker.</p>\n<hr />\n<p>You sense how an incoming attack moves through ambient primal energy, predicting how best to dodge. The triggering attack targets your Survival DC instead of your AC. Though this allows you to avoid taking penalties to your AC, it doesn't remove any conditions or other effects causing such penalties. For example, an enemy with sneak attack would still deal extra damage to you for being @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard], even though you wouldn't take the –2 circumstance penalty when defending against the attack.</p>"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Verduran Shadow Dedication"
              },
              {
                "value": "master in Survival"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder #201: Pactbreaker"
          },
          "rules": [],
          "traits": {
            "rarity": "uncommon",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 10,
      "category": "class"
    },
    {
