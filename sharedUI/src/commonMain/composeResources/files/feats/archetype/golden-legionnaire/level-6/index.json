        "name": "Commitment to Protection",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "skill",
          "description": {
            "value": "<p>You attempt to guide an ally into a more defensive pose against a particular danger. Attempt a @Check[warfare-lore] check against the hard DC for the level of a creature or hazard you can see. An ally of your choice within 30 feet gains an effect based on the outcome. If you're legendary in Warfare Lore, when you roll a failure or critical failure, you get a success instead.</p><hr /><p><strong>Critical Success</strong> The ally gains a +2 circumstance bonus to AC against the target creature's or hazard's next attack.</p>\n<p><strong>Success</strong> As critical success, but the bonus is +1.</p>\n<p><strong>Critical Failure</strong> The ally takes a –1 circumstance penalty to AC against the target creature's or hazard's next attack.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Commitment to Protection]</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "Golden Legionnaire Dedication"
              },
              {
                "value": "expert in Warfare Lore"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Hellfire Dispatches"
          },
