      "id": "v2AScyQidSsrfm6z",
      "name": "Slowing Strike",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "v2AScyQidSsrfm6z",
        "folder": "bviEMqBLpX2bzyPl",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Slowing Strike",
        "system": {
          "actionType": {
            "value": "free"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Trigger</strong> Your Strike hits an @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] creature and deals damage.</p><hr /><p>You wound your enemy so they can't move nimbly. The target must attempt a @Check[fortitude|against:class-spell] save against your class DC or spell DC, whichever is higher.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a –10-foot status penalty to its Speeds until the beginning of your next turn.</p>\n<p><strong>Failure</strong> As success, but the penalty lasts for 1 minute.</p>"
          },
