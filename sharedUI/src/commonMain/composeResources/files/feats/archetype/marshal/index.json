            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
      "category": "class"
    },
    {
      "fileName": "cadence-call.json",
      "id": "a9zzu4kb7vstq0HQ",
      "name": "Cadence Call",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "a9zzu4kb7vstq0HQ",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Cadence Call",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per minute</p><hr /><p>You call out a quick cadence, guiding your allies into a more efficient rhythm. Each willing ally in your marshal's aura is @UUID[Compendium.pf2e.conditionitems.Item.Quickened] until the end of their next turn, and they can use the extra action only to Stride.</p>\n<p>If an ally uses this extra action, at the end of its turn that ally becomes @UUID[Compendium.pf2e.conditionitems.Item.Slowed]{Slowed 1} until the end of its following turn.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT1M"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "Marshal Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "auditory",
              "flourish"
            ]
          }
        },
        "type": "feat"
      },
      "level": 6,
      "category": "class"
    },
    {
      "fileName": "coordinated-charge.json",
      "id": "KYF9e4oeSjHKgbwM",
      "name": "Coordinated Charge",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "KYF9e4oeSjHKgbwM",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Coordinated Charge",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 2
          },
          "category": "class",
          "description": {
            "value": "<p>You heroically dash into the fray, inspiring your allies to follow. You Stride up to your Speed and make a melee Strike. If your Strike hits and damages an enemy, each ally within 60 feet who saw you hit can use a reaction to Stride, but they each must end their Stride closer to the creature you hit than where they started.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Marshal Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "visual"
            ]
          }
        },
        "type": "feat"
      },
      "level": 12,
      "category": "class"
    },
    {
      "fileName": "dread-marshal-stance.json",
      "id": "R7c4PyTNkZb0yvoT",
      "name": "Dread Marshal Stance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "R7c4PyTNkZb0yvoT",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Dread Marshal Stance",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>Putting on a grim face for the battle ahead, you encourage your allies to strike fear into their foes with vicious attacks. When you use this action, attempt an @Check[intimidation|dc:@self.level|adjustment:-2|roller:self] check. The DC is usually an easy DC of your level, but the GM can assign a different DC based on the circumstances. The effect depends on the result of your check.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Stance: Dread Marshal Stance]</p><hr /><p><strong>Success</strong> Your marshal's aura grants you and your allies in the aura a +1 status bonus to damage rolls. When you or an ally in the aura critically hit an enemy with a Strike, that enemy is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}. If you're wielding a weapon that has more than one damage die (typically due to a striking rune), you can have the status bonus equal the weapon's number of damage dice instead of +1.</p>\n<p><strong>Failure</strong> You fail to enter the stance.</p>\n<p><strong>Critical Failure</strong> You fail to enter the stance and can't take this action again for 1 minute.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Marshal Dedication"
              },
              {
                "value": "trained in Intimidation"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "stance"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "class"
    },
    {
      "fileName": "form-up.json",
      "id": "UpnXrLhJZ06HTaJh",
      "name": "Form Up!",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "UpnXrLhJZ06HTaJh",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Form Up!",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 2
          },
          "category": "class",
          "description": {
            "value": "<p>You've trained in battle formations for a plethora of situations. Choose a formation. Allies within your aura can use their reaction to Stride up to their Speed and take a place in the chosen formation. Allies can't benefit from this movement if there isn't room for them in the chosen formation. If there are more eligible allies than there are available spaces in the chosen formation, you choose which allies benefit.</p><ul><li><strong>Line</strong> Your allies gather adjacent to you and each other to form a straight line in a direction of your choosing.</li><li><strong>Wedge</strong> Your allies gather into any space that would be covered by a @Template[type:cone|distance:15] originating from you in a direction of your choosing.</li><li><strong>Cluster</strong> Your allies gather into any space that would be covered by a @Template[type:emanation|distance:15] in an aura around you.</li></ul>"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Marshal Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "auditory",
              "flourish"
            ]
          }
        },
        "type": "feat"
      },
      "level": 10,
      "category": "class"
    },
    {
      "fileName": "generals-gambit.json",
      "id": "HX67CcR59JO2RJXI",
      "name": "General's Gambit",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "HX67CcR59JO2RJXI",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "General's Gambit",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 3
          },
          "category": "class",
          "description": {
            "value": "<p>You move strategically forward to draw the enemy's attention away from your allies. You Stride toward an enemy and attempt to @UUID[Compendium.pf2e.actionspf2e.Item.Create a Diversion], except you can use Society or Warfare Lore instead of Deception.</p>\n<p>On a success, in addition to the normal outcome for Creating a Diversion, the enemy becomes @UUID[Compendium.pf2e.conditionitems.Item.Fascinated] with you until the start of your next turn and can't use reactions against allies in your aura. On a critical success, the enemy becomes fascinated with you until the end of your next turn.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Marshal Dedication"
              },
              {
                "value": "Strategist Stance"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 12,
      "category": "class"
    },
