    {
      "fileName": "snap-out-of-it-marshal.json",
      "id": "zbnL5OP4zVaNFcq8",
      "name": "Snap Out of It! (Marshal)",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "zbnL5OP4zVaNFcq8",
        "folder": "Ji2CbKYOXGa69X7A",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Snap Out of It! (Marshal)",
        "system": {
          "actionType": {
            "value": "action"
