    {
      "fileName": "reactive-resilience.json",
      "id": "f58Vhv4R4J6a7ie9",
      "name": "Reactive Resilience",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "f58Vhv4R4J6a7ie9",
        "folder": "JrW9SiDN0kRE26sN",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Reactive Resilience",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per day</p>\n<p><strong>Trigger</strong> You take damage.</p>\n<p><strong>Requirements</strong> You are @UUID[Compendium.pf2e.actionspf2e.Item.Channel Draconic Essence]{Channeling Draconic Essence}.</p><hr /><p>Your power blunts blades and weakens spells like the hardiest of dragon scales. You gain resistance to the triggering damage equal to your level. Channel Draconic Essence ends.</p>"
