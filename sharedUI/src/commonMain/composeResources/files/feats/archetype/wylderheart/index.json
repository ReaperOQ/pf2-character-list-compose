    {
      "fileName": "wild-dance.json",
      "id": "fHux2F9oZGzOj3GL",
      "name": "Wild Dance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "fHux2F9oZGzOj3GL",
        "folder": "OB0hHuUjROemcE5L",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Wild Dance",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>The combination of your passion for both life and the battle against evil makes you graceful and unpredictable. Stride up to your Speed. A creature that attempts a reaction triggered by this movement must first attempt a @Check[will|against:class-spell] save against your class DC or spell DC, whichever is higher.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.Fascinated] by you until the end of your next turn.</p>\n<p><strong>Failure</strong> The creature is fascinated by you until the end of your next turn, but your movements might be too hard to follow; if the reaction requires an attack roll, you gain a +2 circumstance bonus to AC against that attack roll.</p>\n<p><strong>Critical Failure</strong> The creature is fascinated by you until the end of your next turn, and it loses its reaction.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Wylderheart Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Shining Kingdoms"
          },
          "rules": [],
