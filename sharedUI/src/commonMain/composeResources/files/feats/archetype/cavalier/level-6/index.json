        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Dashing Pickup",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "skill",
          "description": {
            "value": "<p>You Command an Animal to order your mount to Stride (or to Burrow, Climb, Fly, or Swim if it has the corresponding movement type). At any point during this movement, it must move adjacent to you. As it passes you, you @UUID[Compendium.pf2e.actionspf2e.Item.Mount] your mount. You can increase the number of actions you use with Dashing Pickup to 2 to make your mount Stride twice, or to 3 to make your mount Stride four times; you must use enough actions to ensure your mount is able to move adjacent to you at some point during this movement, and you cannot use this activity if it is not possible for your mount to do so.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "Cavalier Dedication"
              },
              {
                "value": "expert in Acrobatics or Athletics"
              }
            ]
          },
          "publication": {
