        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Familiar Ritualist",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>Your familiar's magical presence can serve as an aspect of a ritual. When you cast a ritual, your familiar can serve as a secondary caster, fulfilling any requirements for the secondary caster as well as a secondary check. You can't replace a secondary caster who's the target of the spell.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "Familiar Sage Dedication"
              },
              {
                "value": "ability to cast a ritual"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
      "category": "class"
