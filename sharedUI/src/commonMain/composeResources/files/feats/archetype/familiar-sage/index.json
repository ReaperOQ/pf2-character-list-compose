    {
      "fileName": "seal-of-the-golden-dragon.json",
      "id": "JCnTkz7Ad11rZKrL",
      "name": "Seal of the Golden Dragon",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "JCnTkz7Ad11rZKrL",
