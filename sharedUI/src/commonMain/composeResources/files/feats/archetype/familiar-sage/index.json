              "mergeable": true,
              "option": "spellshape",
              "placement": "spellcasting",
              "suboptions": [
                {
                  "label": "{item|name}",
                  "value": "golden-dragons-bounty"
                }
              ],
              "toggleable": true
            },
            {
              "alwaysActive": true,
              "domain": "spell-damage",
              "key": "RollOption",
              "label": "PF2E.PreciousMaterialLabel",
              "option": "damage:material",
              "placement": "spellcasting",
              "predicate": [
                "spellshape:golden-dragons-bounty"
