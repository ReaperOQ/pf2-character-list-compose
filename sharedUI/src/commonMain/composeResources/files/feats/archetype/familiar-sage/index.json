    {
      "fileName": "familiar-sage-dedication.json",
      "id": "YKBDNQEqYPKE8dlH",
      "name": "Familiar Sage Dedication",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "YKBDNQEqYPKE8dlH",
        "folder": "B76a7EIYngopXFoj",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Familiar Sage Dedication",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You've forged an empowered mystical bond with your familiar. You gain the @UUID[Compendium.pf2e.feats-srd.Item.Enhanced Familiar] feat, increasing your familiar's number of abilities.</p><hr /><p><strong>Special</strong> You can take Familiar Sage Dedication even if you haven't yet gained three feats from the @UUID[Compendium.pf2e.journals.JournalEntry.vx5FGEG34AxI2dow.JournalEntryPage.yaR8E2drX6pFUFCK]{Familiar Master} archetype, and you can take Familiar Master Dedication even if you haven't yet gained three feats from the familiar sage archetype. You can't select another dedication feat until you've gained two other feats from the familiar master or @UUID[Compendium.pf2e.journals.JournalEntry.vx5FGEG34AxI2dow.JournalEntryPage.bi4WaRQzrOwuEILM]{Familiar Sage} archetypes.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "You have a familiar"
              },
              {
                "value": "you're able to cast spells"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [
            {
              "key": "GrantItem",
              "uuid": "Compendium.pf2e.feats-srd.Item.Enhanced Familiar"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "dedication"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "class"
