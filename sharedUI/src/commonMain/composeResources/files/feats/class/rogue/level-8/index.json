    {
      "fileName": "ricochet-stance-rogue.json",
      "id": "RsNvCSrCN7czHC0G",
      "name": "Ricochet Stance (Rogue)",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "RsNvCSrCN7czHC0G",
        "folder": "7Sq5svRHC6cnEFkC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Ricochet Stance (Rogue)",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You adopt a stance to rebound your thrown weapons toward you. While you are in this stance, any thrown weapons you use as part of a ranged Strike to deal bludgeoning or slashing damage immediately return to your hand, enabling you to use them for additional Strikes. You must be within the weapon's listed range increment and have a hand free to catch the weapon. If you make a ranged Strike with a thrown weapon outside of its listed range increment, it instead flies back toward you a number of feet equal to its listed range increment and then falls to the ground.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "selfEffect": {
            "name": "Stance: Ricochet Stance",
            "uuid": "Compendium.pf2e.feat-effects.Item.Stance: Ricochet Stance"
          },
          "traits": {
            "rarity": "common",
            "value": [
              "rogue",
              "stance"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
      "category": "class"
    },
    {
      "fileName": "sidestep.json",
