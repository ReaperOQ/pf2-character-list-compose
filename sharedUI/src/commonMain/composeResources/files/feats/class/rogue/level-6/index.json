            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You keep watch for any @UUID[Compendium.pf2e.conditionitems.Item.Hidden] creatures or dangerous sites, moving at half your travel Speed. If you're Anticipating an Ambush at the start of an encounter, you roll a Perception check for initiative, and all enemies rolling Stealth for initiative take a –2 circumstance penalty to their Stealth checks.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "expert in Stealth"
