    {
      "fileName": "dragon-transformation.json",
      "id": "lgEihn7deZwHczGE",
      "name": "Dragon Transformation",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "lgEihn7deZwHczGE",
        "folder": "olWKqIyR9YJPlesy",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Dragon Transformation",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You transform into a ferocious Large dragon, gaining the effects of 6th-rank @UUID[Compendium.pf2e.spells-srd.Item.Dragon Form] except that you use your own AC and attack modifier, you apply your extra damage from @UUID[Compendium.pf2e.actionspf2e.Item.Rage], and the Dragon Breath action uses your class DC. Add the temporary Hit Points from dragon form to any you already have from entering a rage (or any other action with the rage trait). The action to Dismiss the transformation gains the rage trait.</p>\n<p>At 18th level, you gain a +20-foot status bonus to your fly Speed, your damage bonus with dragon Strikes increases to +12, and you gain a +14 status bonus to your Dragon Breath damage.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT10M"
          },
          "level": {
            "value": 16
          },
          "prerequisites": {
            "value": [
              {
                "value": "Dragon's Rage Wings"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
