      "data": {
        "_id": "Q21KzuubUBBkoges",
        "folder": "pmTgXsGvTVKiUkuK",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Gigaton Strike",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>When you use a full-power Megaton Strike, you can knock your foe back. When you succeed at your Strike while using an unstable Megaton Strike, your target must attempt a @Check[fortitude|against:inventor] save against your class DC.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is pushed back 5 feet.</p>\n<p><strong>Failure</strong> The creature is pushed back 10 feet.</p>\n<p><strong>Critical Failure</strong> The creature is pushed back 20 feet.</p><hr /><p><strong>Special</strong> If your innovation is a minion, this benefit applies on its unstable Megaton Strikes.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "Megaton Strike"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Guns & Gears"
          },
          "rules": [
            {
              "key": "Note",
              "predicate": [
                "megaton-strike",
                "unstable-state"
              ],
              "selector": "strike-damage",
              "text": "{item|description}"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "inventor"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
