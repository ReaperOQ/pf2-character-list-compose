    {
      "fileName": "electrify-armor.json",
      "id": "LvmYfUGX3uDCpIHY",
      "name": "Electrify Armor",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "LvmYfUGX3uDCpIHY",
        "folder": "RI7Wht7RxGyl68dq",
