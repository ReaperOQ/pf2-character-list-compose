      "id": "07jxXvRZ8nD3JLF4",
      "name": "Imposing Destrier",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "07jxXvRZ8nD3JLF4",
