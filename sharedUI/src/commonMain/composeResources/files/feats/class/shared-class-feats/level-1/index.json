    {
      "fileName": "youre-next.json",
      "id": "gjec0ts3wkFbjvHN",
      "name": "You're Next",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "gjec0ts3wkFbjvHN",
        "folder": "F3ue3RXoxcXCoqfP",
