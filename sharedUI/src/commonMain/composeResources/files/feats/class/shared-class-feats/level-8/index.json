    {
      "fileName": "know-it-all.json",
      "id": "1qJCMbs3zcPMWDux",
      "name": "Know-It-All",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "1qJCMbs3zcPMWDux",
        "folder": "fyeZAb6UU0hj94Ck",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Know-It-All",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Bard</strong> When you succeed at a check to Recall Knowledge, you gain additional information or context. When you critically succeed at a check to Recall Knowledge, you get additional information or context or can ask an additional follow-up question (the GM chooses which).</p>\n<p><strong>Thaumaturge</strong> Having heard and scrutinized every rumor or story in the book, you know for a fact that if you've heard something at all, you've probably heard about it at great length. When you succeed or critically succeed at a check to @UUID[Compendium.pf2e.actionspf2e.Item.Recall Knowledge], you can ask an additional follow-up question. At the GM's discretion, you might gain even more additional context than normal.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "enigma muse"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Dark Archive (Remastered)"
          },
          "rules": [
            {
              "key": "Note",
              "outcome": [
                "criticalSuccess",
                "success"
              ],
              "predicate": [
                "action:recall-knowledge"
              ],
              "selector": "skill-check",
              "text": "{item|system.description.value}",
              "title": "{item|name}"
            },
            {
              "itemId": "{item|id}",
              "key": "ItemAlteration",
