              "property": "description",
              "value": [
                {
                  "predicate": [
                    "class:bard"
                  ],
                  "text": "PF2E.SpecificRule.Feat.KnowItAll.Bard"
                },
                {
                  "predicate": [
                    "class:thaumaturge"
                  ],
                  "text": "PF2E.SpecificRule.Feat.KnowItAll.Thaumaturge"
                }
