    {
      "fileName": "dodging-roll.json",
      "id": "nBWoZ311FXFJC8Zl",
      "name": "Dodging Roll",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "nBWoZ311FXFJC8Zl",
        "folder": "Ju3sxyqzG7uKpMSC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Dodging Roll",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> You take damage from an area effect that allows a Reflex save.</p>\n<hr />\n<p>You dodge a blow at the last possible moment.</p>\n<p>You Step and gain resistance to all damage equal to your level against the triggering effect. If your Step moves you out of the triggering effect's area, this resistance is instead equal to your level plus your Dexterity modifier.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "master in Acrobatics"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "RollOption",
              "option": "dodging-roll",
              "suboptions": [
                {
                  "label": "PF2E.SpecificRule.Monk.DodgingRoll.StepIn",
                  "value": "in"
                },
                {
                  "label": "PF2E.SpecificRule.Monk.DodgingRoll.StepOut",
                  "value": "out"
                }
              ],
              "toggleable": true
            },
            {
              "key": "Resistance",
              "predicate": [
                "dodging-roll:in"
              ],
              "type": "all-damage",
              "value": "@actor.level"
            },
            {
              "key": "Resistance",
              "predicate": [
                "dodging-roll:out"
              ],
              "type": "all-damage",
              "value": "@actor.level + @actor.abilities.dex.mod"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "monk"
            ]
          }
        },
        "type": "feat"
      },
      "level": 12,
      "category": "class"
    },
    {
      "fileName": "five-gods-ram.json",
      "id": "gq1gGsJDLQuQDrhW",
      "name": "Five-Gods Ram",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "gq1gGsJDLQuQDrhW",
        "folder": "Ju3sxyqzG7uKpMSC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Five-Gods Ram",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 3
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're in @UUID[Compendium.pf2e.feats-srd.Item.Rushing Goat Stance].</p><hr /><p>You attack in an unceasing flurry of charging headbutts. Stride or Climb and then make a ramming horn Strike. If the Strike is successful, you immediately push the target back 10 feet, then Stride or Climb and make a second ramming horn Strike against them. If the second Strike is successful, you immediately knock the target @UUID[Compendium.pf2e.conditionitems.Item.Prone], but if the second Strike is a failure or if you're unable to complete all the required actions, you become @UUID[Compendium.pf2e.conditionitems.Item.Stunned]{Stunned 1}.</p>\n<p>Both Strikes count toward your multiple attack penalty, but the penalty doesn't increase until you've made both of them.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Rushing Goat Stance"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [
            {
              "disabledIf": [
                {
                  "not": "self:effect:rushing-goat-stance"
                }
              ],
              "disabledValue": false,
              "key": "RollOption",
              "label": "PF2E.SpecificRule.Monk.FiveGodsRam.RollOptionLabel",
              "option": "five-gods-ram",
              "suboptions": [
                {
                  "label": "PF2E.GenericLabel.StrikeCount.First",
                  "value": "first-strike"
                },
                {
                  "label": "PF2E.GenericLabel.StrikeCount.Second",
                  "value": "second-strike"
                }
              ],
              "toggleable": true
            },
            {
              "key": "Note",
              "outcome": [
                "success",
                "criticalSuccess"
              ],
              "predicate": [
                "five-gods-ram:first-strike"
              ],
              "selector": [
                "ramming-horn-attack-roll"
              ],
              "text": "PF2E.SpecificRule.Monk.FiveGodsRam.FirstStrike.Note",
              "title": "{item|name}"
            },
            {
              "key": "Note",
              "outcome": [
                "success",
                "criticalSuccess"
              ],
              "predicate": [
                "five-gods-ram:second-strike"
              ],
              "selector": [
                "ramming-horn-attack-roll"
              ],
              "text": "PF2E.SpecificRule.Monk.FiveGodsRam.SecondStrike.Note",
              "title": "{item|name}"
            },
            {
              "key": "Note",
              "outcome": [
                "failure",
                "criticalFailure"
              ],
              "predicate": [
                {
                  "or": [
                    "five-gods-ram:first-strike",
                    "five-gods-ram:second-strike"
                  ]
                }
              ],
              "selector": [
                "ramming-horn-attack-roll"
              ],
              "text": "PF2E.SpecificRule.Monk.FiveGodsRam.FailureNote",
              "title": "{item|name}"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "monk"
            ]
          }
        },
        "type": "feat"
      },
      "level": 12,
      "category": "class"
