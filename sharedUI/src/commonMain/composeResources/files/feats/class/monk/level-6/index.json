    {
      "fileName": "mountain-stronghold.json",
      "id": "n2hawNmzW7DBn1Lm",
      "name": "Mountain Stronghold",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "n2hawNmzW7DBn1Lm",
        "folder": "5fWVGjsONPZTddWC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Mountain Stronghold",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You are in @UUID[Compendium.pf2e.feats-srd.Item.Mountain Stance]</p>\n<hr />\n<p>You focus on your connection to the earth and call upon the mountain to block attacks against you. You gain a +2 circumstance bonus to AC until the beginning of your next turn.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Mountain Stronghold]</p>\n<hr />\n<p><strong>Special</strong> If you have this feat, the Dexterity modifier cap to your AC while you're in @UUID[Compendium.pf2e.feats-srd.Item.Mountain Stance] increases from +0 to +1.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "Mountain Stance"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "DexterityModifierCap",
