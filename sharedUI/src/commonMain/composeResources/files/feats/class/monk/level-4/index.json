      "data": {
        "_id": "AkV4Jyllo6nlK2Sl",
        "folder": "8bM5gwt3cczyJO67",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Cobra Stance",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You enter a tight stance, coiled up like a lashing cobra with your hands poised as venomous fangs.</p>\n<p>While in this stance, the only Strikes you can make are cobra fang unarmed attacks. These deal 1d4 piercing damage; are in the brawling group; and have the agile, deadly d10, finesse, unarmed, and venomous traits.</p>\n<p>While in Cobra Stance, you gain a +1 circumstance bonus to Fortitude saves and your Fortitude DC, and you gain poison resistance equal to half your level.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "selfEffect": {
            "name": "Stance: Cobra Stance",
            "uuid": "Compendium.pf2e.feat-effects.Item.Stance: Cobra Stance"
          },
          "traits": {
            "rarity": "common",
            "value": [
              "monk",
              "stance"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "class"
    },
