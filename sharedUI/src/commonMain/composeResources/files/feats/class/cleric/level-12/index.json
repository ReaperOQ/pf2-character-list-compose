        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> While you have your symbol raised, you are about to take damage from a melee attack.</p>\n<hr />\n<p>Your religious symbol glows with sacred energy, turning the attacker's strength to weakness. Attempt a @Check[religion|defense:will] check against the triggering creature's Will DC. Regardless of the result, the creature is temporarily immune for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 2} until it spends at least 1 action moving away from you.</p>\n<p><strong>Success</strong> As critical success, but @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 1}.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Raise Symbol"
              }
            ]
          },
