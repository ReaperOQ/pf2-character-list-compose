            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> Your turn begins, and one target within 30 feet failed an attack roll or skill check against you on its last turn.</p><hr /><p>You capitalize on an opponent's failure with smug attitude and swagger, reminding them of the gap in skill between you and your opponent. You attempt to [[/act demoralize traits=bravado]] the opponent. Regardless of the result, the target becomes temporarily immune for 1 minute.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
