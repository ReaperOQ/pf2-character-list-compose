            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "swashbuckler"
            ]
          }
        },
        "type": "feat"
      },
      "level": 6,
      "category": "class"
