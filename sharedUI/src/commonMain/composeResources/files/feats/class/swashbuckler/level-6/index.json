        "name": "Vexing Tumble",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You tumble around your foes, expertly avoiding their reactions. Stride up to half your Speed and roll an @Check[acrobatics] check. Compare the result to the Reflex DC of each enemy whose reach you began in or enter during the movement, in sequence.</p><hr /><p><strong>Critical Success</strong> This movement doesn't trigger reactions from the enemy, and the enemy is @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] to you until the end of your turn</p>\n<p><strong>Success</strong> This movement doesn't trigger reactions from the enemy.</p>\n<p><strong>Critical Failure</strong> Your movement immediately stops when you enter the creature's reach; if you began in the creature's reach, you don't move.</p>"
          },
