    {
      "fileName": "flying-blade.json",
      "id": "qgNc5XwjsaWET0Op",
      "name": "Flying Blade",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "qgNc5XwjsaWET0Op",
        "folder": "sFR0R8pEufzoKbfT",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Flying Blade",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You apply your flashy techniques to thrown weapons as easily as melee attacks. You apply your @UUID[Compendium.pf2e.classfeatures.Item.Precise Strike] damage on ranged Strikes you make with a thrown weapon within that weapon's first range increment. The thrown weapon must be an agile or finesse weapon. This also allows you to make a thrown weapon ranged Strike for @UUID[Compendium.pf2e.actionspf2e.Item.Confident Finisher] and any other finisher that includes a Strike that can benefit from your precise strike.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": [
              {
                "value": "precise strike"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "RollOption",
              "label": "PF2E.SpecificRule.TOTMToggle.FirstRangeIncrement",
              "option": "target:range-increment:1",
              "toggleable": "totm"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "swashbuckler"
            ]
          }
        },
        "type": "feat"
      },
