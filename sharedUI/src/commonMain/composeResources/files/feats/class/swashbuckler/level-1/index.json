          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>With precisely the right words of encouragement, you bolster an ally's efforts. Designate an ally within 30 feet; this action counts as sufficient preparation to @UUID[Compendium.pf2e.actionspf2e.Item.Aid] that ally. When you use the Aid reaction to help that ally, you can roll @Check[diplomacy|traits:action:aid,bravado] in place of the usual check and the action gains the bravado trait</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
