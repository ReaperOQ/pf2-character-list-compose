      "id": "ecV3Nljvs4FOBS27",
      "name": "Reverberate",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "ecV3Nljvs4FOBS27",
        "folder": "bx2kMs2jyRM2VELk",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Reverberate",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature or hazard would deal sonic damage to you.</p>\n<hr />\n<p>You can manipulate the acoustics around you to deflect sonic damage back at its source. Attempt a Performance check against the @Check[performance|defense:will]{Will DC} of the creature or @Check[performance|defense:fortitude]{Fortitude DC} of a hazard. If the damage came from a spell, use the creature's spell DC if it's lower.</p>\n<hr />\n<p><strong>Critical Success</strong> You reduce the triggering damage by an amount up to four times your level. The creature takes sonic damage equal to the amount of damage you reduced in this way.</p>\n<p><strong>Success</strong> As critical success, but you reduce the triggering damage by an amount up to twice your level.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "bard"
            ]
          }
        },
        "type": "feat"
      },
