    {
      "fileName": "martial-performance.json",
      "id": "q1iP3SjAF5uceI0M",
      "name": "Martial Performance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "q1iP3SjAF5uceI0M",
        "folder": "PjZAIwQbMpPCznpr",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Martial Performance",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>Your muse has taught you how to handle a wider variety of weapons than most bards, empowering you to effortlessly blend your performance into combat tools. When you have a @UUID[Compendium.pf2e.spells-srd.Item.Courageous Anthem] composition cantrip active, and you damage an enemy with a Strike, the spell's duration is extended by 1 round. You can extend an individual casting only once in this way.</p>\n<p>If you gain the @UUID[Compendium.pf2e.spells-srd.Item.Rallying Anthem] or @UUID[Compendium.pf2e.spells-srd.Item.Song of Strength] composition cantrips, you can apply this benefit to those cantrips as well.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": [
              {
                "value": "warrior muse"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "subfeatures": {
            "proficiencies": {}
          },
          "traits": {
            "rarity": "common",
            "value": [
              "bard"
            ]
          }
        },
        "type": "feat"
      },
