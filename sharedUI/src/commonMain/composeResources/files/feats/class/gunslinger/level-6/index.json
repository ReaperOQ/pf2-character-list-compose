          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You gain the @UUID[Compendium.pf2e.journals.JournalEntry.vx5FGEG34AxI2dow.JournalEntryPage.Jkl5KOZih7MoMqAJ#quick-alchemy-benefits] benefits, creating up to 4 versatile vials during your daily preparations. You can use @UUID[Compendium.pf2e.actionspf2e.Item.Quick Alchemy] only to create bombs or alchemical ammunition. Using Quick Alchemy to create alchemical ammunition also counts as 1 action toward activating that ammunition.</p>"
          },
