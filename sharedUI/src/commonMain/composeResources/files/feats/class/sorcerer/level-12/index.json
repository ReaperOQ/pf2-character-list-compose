        "name": "Greater Spiritual Evolution",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>Your magical blood allows your spells to be fully effective against incorporeal creatures. Your spells have the effects of a @UUID[Compendium.pf2e.equipment-srd.Item.Ghost Touch] property rune. They can target or affect a creature projecting its consciousness (such as via @UUID[Compendium.pf2e.spells-srd.Item.Project Image]) or possessing another creature, even if its body is elsewhere, though you must know about the possession or projection and choose to do so. Your spells can affect creatures on the Ethereal Plane, though this doesn't grant you the ability to locate them.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": [
              {
                "value": "Divine Evolution or Occult Evolution"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "domain": "spell-damage",
              "key": "RollOption",
              "option": "item:rune:property:ghost-touch"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "sorcerer"
            ]
          }
        },
        "type": "feat"
      },
