    {
      "fileName": "greater-spiritual-evolution.json",
      "id": "gVLICIDQMvWN5D89",
      "name": "Greater Spiritual Evolution",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "gVLICIDQMvWN5D89",
        "folder": "EnD5yeoAsfP0ywPq",
