    {
      "fileName": "storm-retribution.json",
      "id": "F1DVDJRARfdb1Kjz",
      "name": "Storm Retribution",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "F1DVDJRARfdb1Kjz",
        "folder": "KN2J6CzNZruC0diG",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Storm Retribution",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> An opponent adjacent to you critically hits you with a melee weapon or melee unarmed attack.</p>\n<p><strong>Requirements</strong> You have at least 1 available Focus Point.</p>\n<hr />\n<p>You lash out, directing a burst of storming fury toward a creature that has harmed you. You cast @UUID[Compendium.pf2e.spells-srd.Item.Tempest Surge] on the triggering opponent and push that creature, moving it 5 feet away from you if it fails its Reflex save, or 10 feet if it critically fails. This movement is forced movement.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "storm order"
              },
              {
                "value": "tempest surge order spell"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
