    {
      "fileName": "cryptic-spell.json",
      "id": "6oObLoUn3MjmwbaW",
      "name": "Cryptic Spell",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "6oObLoUn3MjmwbaW",
        "folder": "WcFI6pn3UF9oIsV9",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Cryptic Spell",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're in natural terrain.</p><hr /><p>You hide your magic in the croak of a frog, in the sway of the trees, in the howl of the wind, and the flicker of the will-o'-wisp. If the next action you take is to Cast a Spell, the spell gains the subtle trait, masking the spell's manifestations in the natural sights and sounds of the environment.</p>\n<p>The trait hides only the spell's spellcasting actions and manifestations, not its effects, so an observer might still see you transform into a giant bear.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Dark Archive (Remastered)"
          },
          "rules": [
            {
              "itemType": "spell",
              "key": "ItemAlteration",
