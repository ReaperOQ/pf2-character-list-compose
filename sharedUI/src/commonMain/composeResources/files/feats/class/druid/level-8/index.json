    {
      "fileName": "raise-menhir.json",
      "id": "BuVIM4cV7qhVZ2WF",
      "name": "Raise Menhir",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "BuVIM4cV7qhVZ2WF",
        "folder": "A3uR1mpLuGu1HA6M",
