    {
      "fileName": "floral-restoration.json",
      "id": "ffLzfZIq7LoNXqWO",
      "name": "Floral Restoration",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "ffLzfZIq7LoNXqWO",
        "folder": "A3uR1mpLuGu1HA6M",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Floral Restoration",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per day</p><hr /><p>You request that nearby plants share their vitality with you to replenish your body and magic. You regain 1 Focus Point and @Damage[ceil(@item.level/2)d8[healing]] Hit Points.</p>\n<p>You must be in a location of at least 15 feet by 15 feet of healthy plant life, though this can be grass, lichen, seaweed, or any other form of naturally occurring flora. Using Floral Restoration on a given section of nature does not harm it, but it prevents that section of nature from giving its vitality to another use of Floral Restoration for 24 hours.</p>\n<p>At 9th level, and every 2 levels thereafter, increase the healing by 1d8.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "day"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "leaf order"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "druid",
              "healing",
              "vitality"
            ]
          }
        },
        "type": "feat"
      },
      "level": 8,
      "category": "class"
    },
