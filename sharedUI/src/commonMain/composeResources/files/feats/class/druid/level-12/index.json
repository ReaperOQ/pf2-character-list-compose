          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You can take on the shape of some of the world's most fearsome creatures. Add the shapes listed in @UUID[Compendium.pf2e.spells-srd.Item.Dragon Form] to your @UUID[Compendium.pf2e.spells-srd.Item.Untamed Form] list. Whenever you're polymorphed into another form using <em>untamed form</em>, you gain resistance 5 to your choice of bludgeoning or poison.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
