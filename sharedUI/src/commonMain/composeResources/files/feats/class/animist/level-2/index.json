    {
      "fileName": "grasping-spirits-spell.json",
      "id": "qcILhNRHqIbW3xRN",
      "name": "Grasping Spirits Spell",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "qcILhNRHqIbW3xRN",
        "folder": "qmEprfsbYiWhY3JE",
