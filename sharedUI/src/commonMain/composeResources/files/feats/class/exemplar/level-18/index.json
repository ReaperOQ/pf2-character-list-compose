      "fileName": "branched-tree-of-pain.json",
      "id": "dfQdJIqngKIX24UV",
      "name": "Branched Tree of Pain",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "dfQdJIqngKIX24UV",
