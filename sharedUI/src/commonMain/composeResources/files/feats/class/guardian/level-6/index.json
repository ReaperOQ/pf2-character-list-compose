      "name": "Lock Down",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "SiGvSOPQmZ0nyXVO",
        "folder": "yFisFtLM9vV2UJ2L",
