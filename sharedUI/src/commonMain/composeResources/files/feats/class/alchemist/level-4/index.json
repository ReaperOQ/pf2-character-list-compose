    {
      "fileName": "healing-bomb.json",
      "id": "xXHwktc9SymSY8d6",
      "name": "Healing Bomb",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "xXHwktc9SymSY8d6",
        "folder": "q9OytyVXdB4oCLLi",
