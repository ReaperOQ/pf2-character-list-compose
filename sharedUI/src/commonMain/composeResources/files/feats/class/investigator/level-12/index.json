      "id": "pVDgiaqu1RbCOhuv",
      "name": "Foresee Danger",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "pVDgiaqu1RbCOhuv",
        "folder": "pb7GzzVAlrtNCQ5H",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Foresee Danger",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature targets you with an attack and you can see the attacker.</p><hr /><p>You perceive every possible way your foe's attack could land and attempt to avoid them all.</p>\n<p>The triggering attack roll targets your Perception DC instead of your AC. Though this allows you to avoid taking penalties to your AC, it doesn't remove any conditions or other effects causing such penalties.</p>\n<p>For example, an enemy with sneak attack would still deal extra damage to you for being @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard], even though you wouldn't take the –2 circumstance penalty when defending against the attack.</p>"
          },
          "level": {
            "value": 12
          },
          "prerequisites": {
            "value": []
          },
