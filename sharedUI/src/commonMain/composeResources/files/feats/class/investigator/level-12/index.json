      "id": "SwkIcrtHO60FkhEH",
      "name": "Make 'Em Sweat",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "SwkIcrtHO60FkhEH",
