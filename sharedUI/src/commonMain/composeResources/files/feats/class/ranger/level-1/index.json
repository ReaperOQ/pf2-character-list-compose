    {
      "fileName": "hunted-shot.json",
      "id": "c3b7DhnDBC7YEgRG",
      "name": "Hunted Shot",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "c3b7DhnDBC7YEgRG",
