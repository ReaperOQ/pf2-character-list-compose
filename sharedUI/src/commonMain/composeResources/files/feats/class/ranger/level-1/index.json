    {
      "fileName": "crossbow-ace.json",
      "id": "CpjN7v1QN8TQFcvI",
      "name": "Crossbow Ace",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "CpjN7v1QN8TQFcvI",
