        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Convincing Illusion",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature succeeded, but didn't critically succeed, at a Perception check or Will save to disbelieve an illusion from a spell that you cast.</p>\n<p><strong>Requirements</strong> You are within 30 feet of the observer and the illusion.</p>\n<hr />\n<p>You use your deceptive skills to make your illusions seem even more real. Attempt a @Check[deception|defense:perception] check against the target's Perception DC. If you succeed, the target fails to disbelieve the illusion.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "expert in Deception"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "wizard"
            ]
          }
        },
        "type": "feat"
      },
      "level": 6,
      "category": "class"
    },
