    {
      "fileName": "rapid-reattunement.json",
      "id": "F7azgjrHXmvNnpIg",
      "name": "Rapid Reattunement",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "F7azgjrHXmvNnpIg",
