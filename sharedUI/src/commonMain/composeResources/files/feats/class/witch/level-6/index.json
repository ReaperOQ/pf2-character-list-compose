    {
      "fileName": "wild-witchs-armaments.json",
      "id": "Pw2YVi2eJU0GapXN",
      "name": "Wild Witch's Armaments",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "Pw2YVi2eJU0GapXN",
