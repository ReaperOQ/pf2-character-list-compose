              "title": "{item|name}"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "general",
              "skill"
            ]
          }
        },
        "type": "feat"
      },
      "level": 15,
      "category": "skill"
    },
    {
      "fileName": "legendary-guide.json",
      "id": "Vk7BzAb3D9r226sI",
      "name": "Legendary Guide",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "Vk7BzAb3D9r226sI",
        "folder": "zQiQoKjSx6nd1teW",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Legendary Guide",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "skill",
          "description": {
            "value": "<p>You know the wilderness so well that you can help your party travel through it with ease.</p>\n<p>When you are setting the path for your party through wilderness terrain, your party gains a +10-foot circumstance bonus to its Speed for the purpose of calculating the party's travel speed, your party's travel speed doesn't decrease in difficult terrain, and greater difficult terrain halves your party's travel speed instead of reducing it to a third.</p>\n<p>This doesn't increase your party's Speed during an encounter or allow your party to ignore difficult terrain during an encounter.</p>"
          },
          "level": {
            "value": 15
          },
          "prerequisites": {
            "value": [
              {
                "value": "legendary in Survival"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "general",
              "skill"
            ]
          }
        },
        "type": "feat"
      },
      "level": 15,
      "category": "skill"
    },
    {
      "fileName": "legendary-linguist.json",
      "id": "n0S0tJiOJPQk0Rne",
      "name": "Legendary Linguist",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "n0S0tJiOJPQk0Rne",
        "folder": "zQiQoKjSx6nd1teW",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Legendary Linguist",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "skill",
          "description": {
            "value": "<p>You're so skilled with languages you can create a pidgin instantly. You can always talk to any creature that has a language—even a language you don't know—by creating a new pidgin language that uses simplified terms and conveys basic concepts. To do so, you must first understand at least what medium of communication the creature uses (speech, sign language, and so on).</p>"
          },
          "level": {
            "value": 15
          },
          "prerequisites": {
            "value": [
              {
                "value": "legendary in Society"
              },
              {
                "value": "Multilingual"
              }
            ]
          },
          "publication": {
            "license": "ORC",
