        "name": "Spark Fist",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Access</strong> You are from Dongun Hold or Alkenstar.</p>\n<p><strong>Frequency</strong> once per minute</p><hr /><p>You dust explosive black powder on your fist or glove before attacking, which combusts as you hit an opponent. The resulting pops of flame harm both you and your enemy. Until the end of your next turn, your fist loses the nonlethal trait and deals an additional 1 fire damage on a successful Strike. Each time you succeed on a fist Strike, you take 1 fire damage. If your fist would deal more than one weapon damage die, the fire damage dealt on a successful Strike, to both you and your opponent, is equal to the number of weapon damage dice.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT1M"
          },
          "level": {
            "value": 5
          },
          "prerequisites": {
