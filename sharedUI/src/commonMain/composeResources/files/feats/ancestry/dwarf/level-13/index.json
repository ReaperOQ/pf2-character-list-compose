        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Crafter's Instinct",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Access</strong> You are from Dongun Hold or Alkenstar.</p>\n<p><strong>Frequency</strong> once per day</p>\n<p><strong>Trigger</strong> You misfire with a firearm or you roll a failure on a Strike with a ranged weapon.</p><hr /><p>You sense a minor flaw in the weapon as you fire it, and quickly adjust your aim on the fly to avoid the flaw. If the triggering Strike was a misfire, you get a normal failure instead. If the triggering Strike was a failure, it becomes a glancing blow that deals minimum damage for the Strike (adding any bonuses as normal but getting a result of 1 for all damage dice that would be rolled on a success). The glancing blow does not apply other effects that would normally happen only on a hit.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "day"
          },
          "level": {
            "value": 13
          },
          "prerequisites": {
            "value": [
              {
                "value": "master in Crafting"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Guns & Gears"
          },
          "rules": [],
          "traits": {
            "rarity": "uncommon",
            "value": [
              "dwarf",
              "fortune"
            ]
          }
        },
        "type": "feat"
      },
      "level": 13,
      "category": "ancestry"
    },
