        "_id": "Dc5hLCC2qxCDWjX5",
        "folder": "UUTk1SFVEqGhW5le",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Tip the Scales",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You're a cunning adversary in close quarters and are well-versed in hit-and-run tactics that exploit the advantages of your small stature. As part of your training, you learned what to do when you're @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] or @UUID[Compendium.pf2e.conditionitems.Item.Restrained]. You gain a +1 circumstance bonus to checks to Escape, and after resolving a successful Escape action, you can immediately use your reaction to Step or to [[/act shove]] or [[/act trip]] the creature from whom you just Escaped.</p>"
          },
          "level": {
            "value": 5
          },
          "prerequisites": {
            "value": []
