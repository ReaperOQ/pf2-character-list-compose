                "item:trait:finesse",
                {
                  "not": "item:ranged"
                }
              ],
              "key": "AdjustStrike",
              "mode": "add",
              "predicate": [
                "target:condition:off-guard"
              ],
              "property": "weapon-traits",
              "value": "backstabber"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "kobold"
            ]
          }
        },
        "type": "feat"
      },
