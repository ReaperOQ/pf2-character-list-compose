    {
      "fileName": "dracomancer.json",
      "id": "lbiFj4At5BxotaNY",
      "name": "Dracomancer",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "lbiFj4At5BxotaNY",
        "folder": "HuUvevadVxKumpH6",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Dracomancer",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>The power infused into you by your draconic benefactor's presence allows you to manifest their most iconic spells. Choose one 1st-rank spell and one 2nd-rank spell from those listed for a dragon spellcaster of your draconic benefactor's type, (for example, @UUID[Compendium.pf2e.spells-srd.Item.Fear] and @UUID[Compendium.pf2e.spells-srd.Item.Invisibility] for a conspirator dragon benefactor). You can cast each of these spells once per day as innate spells of the same tradition as your draconic benefactor. You gain the trained proficiency rank in the spell attack modifier and spell DC statistics, and your key spellcasting attribute is Charisma.</p>"
          },
          "level": {
            "value": 9
          },
          "prerequisites": {
            "value": [
              {
                "value": "dragonscaled kobold heritage"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Draconic Codex"
          },
          "rules": [],
          "subfeatures": {
            "proficiencies": {
              "spellcasting": {
                "rank": 1
              }
            }
          },
          "traits": {
            "rarity": "common",
            "value": [
              "kobold"
            ]
          }
        },
        "type": "feat"
      },
      "level": 9,
      "category": "ancestry"
