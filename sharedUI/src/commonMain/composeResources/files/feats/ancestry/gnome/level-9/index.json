    {
      "fileName": "life-leap.json",
      "id": "aOIZvx5fx5jVHHOO",
      "name": "Life Leap",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "aOIZvx5fx5jVHHOO",
        "folder": "AVQ4YLK6AJ4bUpKm",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Life Leap",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Requirements</strong> You must be adjacent to a living creature.</p>\n<hr />\n<p>You phase through a space that a living creature occupies in a flash, spontaneously appearing on the opposite side of it in a vibrant display of colorful light. You move from your current location to another location that's still adjacent to the same living creature, but on the opposite side or corner of the creature's space. To determine whether a position is valid, use the same rules as for flanking: a line through the center of the two spaces must pass through opposite sides or corners of the creature's space.</p>\n<p>You pass through the creature's life force, appearing in the selected location; this doesn't trigger reactions based on movement. You must be able to see your destination, and you can't move farther than your Speed would allow.</p>"
          },
          "level": {
            "value": 9
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "gnome",
              "move",
              "teleportation"
            ]
          }
        },
        "type": "feat"
      },
      "level": 9,
      "category": "ancestry"
