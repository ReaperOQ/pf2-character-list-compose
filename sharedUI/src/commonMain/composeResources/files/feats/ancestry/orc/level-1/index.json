    {
      "fileName": "orc-lore.json",
      "id": "254C4rqrE8APDfCf",
      "name": "Orc Lore",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "254C4rqrE8APDfCf",
        "folder": "QW4FChLa1LOdbE1j",
