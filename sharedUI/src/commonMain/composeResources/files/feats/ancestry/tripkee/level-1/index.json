    {
      "fileName": "terrifying-croak.json",
      "id": "T8tNZANOWUZiXuzO",
      "name": "Terrifying Croak",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "T8tNZANOWUZiXuzO",
        "folder": "Iw0dujzKEnLt32xt",
