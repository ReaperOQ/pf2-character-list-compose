        "name": "Terrifying Croak",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You release a haunting croak that reminds those around you of their fears. Attempt an Intimidation check to @UUID[Compendium.pf2e.actionspf2e.Item.Demoralize] a creature within 30 feet; you do not take a penalty to this check for not speaking a language. If the check is successful, the target cannot reduce their frightened condition below 1 for 1 round.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
