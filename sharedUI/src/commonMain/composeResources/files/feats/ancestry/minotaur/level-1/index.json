    {
      "fileName": "eye-for-masonry.json",
      "id": "ULa46pgES3yWw3NJ",
      "name": "Eye for Masonry",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "ULa46pgES3yWw3NJ",
        "folder": "tsnB4XzrYWgVwbAz",
