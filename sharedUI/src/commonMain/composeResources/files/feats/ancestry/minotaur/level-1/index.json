    {
      "fileName": "friendly-nudge.json",
      "id": "8PmPjoqqbOzvUmO2",
      "name": "Friendly Nudge",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
