            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
              "adjustName": false,
              "choices": {
                "filter": [
                  "item:level:1",
                  "item:category:class",
                  "item:trait:{actor|system.details.class.trait}",
                  {
                    "or": [
                      "feature:dragon-instinct",
                      {
                        "not": "item:draconic-arrogance"
                      }
                    ]
                  },
                  {
                    "nor": [
                      "item:animal-companion",
                      "item:animal-companion-druid",
