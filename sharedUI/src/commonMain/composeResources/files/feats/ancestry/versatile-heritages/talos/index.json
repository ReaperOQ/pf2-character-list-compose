      "fileName": "conductors-redirection.json",
      "id": "q2SlRECDwGBtlMl9",
      "name": "Conductor's Redirection",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "q2SlRECDwGBtlMl9",
        "folder": "rHS9A3MjldAHisqC",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Conductor's Redirection",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Trigger</strong> You are hit by an attack, spell, or other effect that deals electricity damage.</p>\n<hr />\n<p>You conduct the damage through your body, taking damage as normal (if applicable) and redirecting it at one target within 10 feet that you can see. That target takes an equal amount of damage with a @Check[fortitude|against:class-spell|basic] save against the higher of your class DC or spell DC. The damage they take is based on the triggering damage, not modified by your degree of success, resistances, and so forth.</p>"
          },
          "level": {
            "value": 5
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "OGL",
            "remaster": true,
            "title": "Pathfinder Rage of Elements"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "talos"
            ]
          }
        },
        "type": "feat"
      },
      "level": 5,
      "category": "ancestry"
    },
