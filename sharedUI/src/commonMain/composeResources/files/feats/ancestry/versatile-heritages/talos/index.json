      "id": "S6ilPkeroXoGgZXm",
      "name": "Natural Magnetism",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "S6ilPkeroXoGgZXm",
        "folder": "rHS9A3MjldAHisqC",
