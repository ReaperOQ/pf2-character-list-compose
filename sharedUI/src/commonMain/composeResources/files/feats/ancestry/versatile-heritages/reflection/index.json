    {
      "fileName": "unyielding-disguise.json",
      "id": "bJTcHDqHOI6xD4AT",
      "name": "Unyielding Disguise",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "bJTcHDqHOI6xD4AT",
        "folder": "XAieOWIiehiOR1pF",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Unyielding Disguise",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>When you cast @UUID[Compendium.pf2e.spells-srd.Item.Humanoid Form] or @UUID[Compendium.pf2e.spells-srd.Item.Illusory Disguise] to alter your appearance, the spell's duration is 2 hours. At the end of the duration, you can extend the spell's duration for another hour, but doing so is taxing, making you @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1}. You can keep extending it in this way, increasing your drained condition by 1 each time, to a maximum duration of 6 hours.</p>"
          },
          "level": {
            "value": 9
          },
          "prerequisites": {
            "value": [
              {
                "value": "ability to cast humanoid form or illusory disguise"
              }
            ]
          },
