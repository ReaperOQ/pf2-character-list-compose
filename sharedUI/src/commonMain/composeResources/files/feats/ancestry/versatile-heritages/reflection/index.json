          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You create a copy of a foe by calling them forth from a nearby reflection, clonally growing them in an instant from one of your hairs or otherwise creating them in a way that matches your own nature as a reflection. You can cast @UUID[Compendium.pf2e.spells-srd.Item.Duplicate Foe] once per day as an innate occult spell. At 20th level, your innate <em>duplicate foe</em> is heightened to 8th rank.</p>"
          },
