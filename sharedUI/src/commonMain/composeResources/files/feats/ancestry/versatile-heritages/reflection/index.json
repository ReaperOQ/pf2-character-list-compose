            "value": [
              "concentrate",
              "fortune",
              "mental",
              "reflection"
            ]
          }
        },
        "type": "feat"
      },
      "level": 5,
      "category": "ancestry"
    },
    {
      "fileName": "morph-risen.json",
      "id": "znX4u20IFE7TPi9Y",
      "name": "Morph-Risen",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "znX4u20IFE7TPi9Y",
        "folder": "XAieOWIiehiOR1pF",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Morph-Risen",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You were once a shapeshifter or spellcaster using polymorph magic, but something went wrong, and you became trapped in the form of the creature you were imitating. This accident might have drained your power, or you might have retained some of your skills, but either way, your form resists further forced transformation. You gain a +1 circumstance bonus to saving throws against morph and polymorph effects, and if you roll a success on a saving throw against a hostile morph or polymorph effect, you get a critical success instead.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Dark Archive (Remastered)"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "predicate": [
                {
                  "or": [
                    "item:trait:morph",
                    "item:trait:polymorph"
                  ]
                }
              ],
              "selector": [
                "saving-throw"
              ],
              "type": "circumstance",
              "value": 1
            },
            {
              "adjustment": {
                "success": "to-critical-success"
              },
              "key": "AdjustDegreeOfSuccess",
              "predicate": [
                {
                  "or": [
                    "item:trait:polymorph",
                    "item:trait:morph"
                  ]
                },
                "origin:enemy"
              ],
              "selector": "saving-throw"
            }
          ],
          "traits": {
