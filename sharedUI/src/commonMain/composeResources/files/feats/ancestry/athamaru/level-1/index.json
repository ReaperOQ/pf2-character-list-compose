    {
      "fileName": "athamaru-weapon-familiarity.json",
      "id": "gtUU8CmyUMzsU5eX",
      "name": "Athamaru Weapon Familiarity",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "gtUU8CmyUMzsU5eX",
