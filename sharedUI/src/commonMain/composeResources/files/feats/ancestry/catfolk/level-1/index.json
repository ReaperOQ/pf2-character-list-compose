      "fileName": "catfolk-dance.json",
      "id": "Iqv8qj7ym63YjexN",
      "name": "Catfolk Dance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "Iqv8qj7ym63YjexN",
        "folder": "W1TAr06mFZSjKsCs",
