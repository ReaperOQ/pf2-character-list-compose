      "id": "Z3zahFC7SzzkX6Cs",
      "name": "Learn by Watching",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "Z3zahFC7SzzkX6Cs",
        "folder": "JJJyxblJvkrgKQmg",
