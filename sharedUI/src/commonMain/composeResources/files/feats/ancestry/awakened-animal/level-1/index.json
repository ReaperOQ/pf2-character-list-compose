        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>When you awakened, primal magic was released within you. Choose one cantrip from the primal spell list. You can cast this spell as an primal innate spell at will. A cantrip is heightened to a spell rank equal to half your level rounded up.</p>"
