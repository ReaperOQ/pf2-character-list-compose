      "fileName": "crawling-form.json",
      "id": "eQl4yt4oZp8U0Sfr",
      "name": "Crawling Form",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "eQl4yt4oZp8U0Sfr",
        "folder": "YllKpxaTpSijAVYc",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Crawling Form",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You can transform into a small animal or celestial creature to scurry and spy. You can Change Shape to assume a crawling form. While in crawling form, you gain the effect of a 1st-rank @UUID[Compendium.pf2e.spells-srd.Item.Pest Form], except you can transform only into a shape matching your heritage; for example, if you were once were a wolf, you turn into a wolf puppy.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": [
              {
                "value": "born of animal or born of celestial heritage"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "yaoguai"
            ]
          }
        },
        "type": "feat"
      },
      "level": 1,
      "category": "ancestry"
    },
    {
      "fileName": "morphic-strike.json",
      "id": "6lMKIvO6McMW0FBJ",
      "name": "Morphic Strike",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "6lMKIvO6McMW0FBJ",
        "folder": "YllKpxaTpSijAVYc",
