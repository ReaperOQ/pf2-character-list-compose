      "name": "Speak with Kindred",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "KYKK1vLqGIxXH5Tu",
        "folder": "uI0xrIAzqRCCptn2",
