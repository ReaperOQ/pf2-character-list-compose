            "name": "Dwarf",
            "slug": "dwarf",
            "uuid": "Compendium.pf2e.ancestries.Item.BYj5ZvlXZdpaEgA6"
          },
          "description": {
            "value": "<p>You have a remarkable adaptation to hot environments. This grants you fire resistance equal to half your level (minimum 1), and you treat environmental heat effects as if they were one step less extreme (incredible heat becomes extreme, extreme heat becomes severe, and so on).</p>"
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
              "key": "Resistance",
