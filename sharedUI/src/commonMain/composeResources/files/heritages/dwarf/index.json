    {
      "fileName": "forge-dwarf.json",
      "id": "5CqsBKCZuGON53Hk",
      "name": "Forge Dwarf",
      "img": "systems/pf2e/icons/features/ancestry/forge-dwarf.webp",
      "type": "heritage",
      "data": {
