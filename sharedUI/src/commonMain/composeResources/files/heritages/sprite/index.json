          },
          "description": {
            "value": "<p>You have batlike features, an affinity for batkind, and hearing that is second to none. As long as you can hear normally, you can use the Seek action to sense @UUID[Compendium.pf2e.conditionitems.Item.Undetected] creatures in a @Template[cone|distance:60] instead of a @Template[cone|distance:30]. You also gain a +2 circumstance bonus to locate undetected creatures that you could hear within 30 feet with a Seek action.</p>"
          },
          "publication": {
            "license": "OGL",
            "remaster": false,
            "title": "Pathfinder Lost Omens Ancestry Guide"
          },
          "rules": [
            {
