    {
      "fileName": "elytron-surki.json",
      "id": "0Anj61DzUimJ1uMS",
      "name": "Elytron Surki",
      "img": "icons/creatures/abilities/wings-birdlike-blue.webp",
      "type": "heritage",
      "data": {
        "_id": "0Anj61DzUimJ1uMS",
