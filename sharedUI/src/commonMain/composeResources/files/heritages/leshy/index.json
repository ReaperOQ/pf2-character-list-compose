    {
      "fileName": "gourd-leshy.json",
      "id": "wNnsjird4OQe0s6p",
      "name": "Gourd Leshy",
      "img": "icons/consumables/vegetable/squash-pumpkin-rough-orange.webp",
      "type": "heritage",
      "data": {
        "_id": "wNnsjird4OQe0s6p",
        "folder": "0oBTqNv5obCMbagQ",
        "img": "icons/consumables/vegetable/squash-pumpkin-rough-orange.webp",
        "name": "Gourd Leshy",
        "system": {
          "ancestry": {
            "name": "Leshy",
            "slug": "leshy",
            "uuid": "Compendium.pf2e.ancestries.Item.cdhgByGG1WtuaK73"
          },
          "description": {
            "value": "<p>You have a large gourd for a skull, and since you don't have a physical brain, you can use the space inside your head. You can store a collection of up to 1 Bulk of objects within your head. The DC of checks to @UUID[Compendium.pf2e.actionspf2e.Item.Steal] objects from inside your head increases by 4. Additionally, if you store only one object within your head, you can draw it effortlessly into your hand as part of another action to use the object. Drawing the item grants this other action the manipulate trait.</p>"
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
              "key": "RollOption",
              "label": "PF2E.SpecificRule.ToggleProperty.GourdHead",
              "option": "gourd-head",
              "toggleable": true
            },
            {
              "key": "FlatModifier",
              "predicate": [
                "action:steal",
                "gourd-head"
              ],
              "selector": "perception-dc",
              "value": 4
            }
          ],
          "traits": {
            "rarity": "common",
            "value": []
          }
        },
        "type": "heritage"
      }
