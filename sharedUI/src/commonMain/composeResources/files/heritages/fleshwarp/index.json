            "slug": "fleshwarp",
            "uuid": "Compendium.pf2e.ancestries.Item.FXlXmNBFiiz9oasi"
          },
          "description": {
            "value": "<p>The biomancers and mutagenists who warped your form labeled you a \"discard on discovery\"—a euphemism for destroying you on sight. An anomaly among anomalies, your body stubbornly repudiates the efforts of fleshcrafters seeking to mold you to their grandiose visions, and your immune responses blunt the worst effects of unwanted fleshwarping attempts. If you roll a success on a saving throw against a transmutation effect, you get a critical success instead.</p>"
          },
          "publication": {
            "license": "OGL",
            "remaster": false,
            "title": "Pathfinder Lost Omens Impossible Lands"
          },
          "rules": [
            {
              "adjustment": {
                "success": "to-critical-success"
              },
              "key": "AdjustDegreeOfSuccess",
              "outcome": [
                "success"
              ],
