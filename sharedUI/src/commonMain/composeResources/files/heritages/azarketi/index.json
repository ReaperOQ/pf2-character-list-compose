    {
      "fileName": "mistbreath-azarketi.json",
      "id": "7wdeVadvchdM0aPK",
      "name": "Mistbreath Azarketi",
      "img": "icons/magic/air/fog-gas-smoke-dense-blue.webp",
      "type": "heritage",
      "data": {
        "_id": "7wdeVadvchdM0aPK",
