    {
      "fileName": "child-of-the-polis.json",
      "id": "ovDOXEuRumNhMU5T",
      "name": "Child of the Polis",
      "img": "systems/pf2e/icons/default-icons/background.svg",
      "type": "background",
      "data": {
        "_id": "ovDOXEuRumNhMU5T",
        "folder": "4h6Y0ehALprvN9Pe",
