    {
      "fileName": "obari-wanderer.json",
      "id": "KrlSyOoVcND109iT",
      "name": "Obari Wanderer",
      "img": "systems/pf2e/icons/default-icons/background.svg",
      "type": "background",
      "data": {
        "_id": "KrlSyOoVcND109iT",
