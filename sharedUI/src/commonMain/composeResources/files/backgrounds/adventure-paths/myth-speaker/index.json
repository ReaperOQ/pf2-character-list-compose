    {
      "fileName": "student-of-apotheosis.json",
      "id": "pZg3dGKD5jAfcJ0E",
      "name": "Student of Apotheosis",
      "img": "systems/pf2e/icons/default-icons/background.svg",
      "type": "background",
      "data": {
        "_id": "pZg3dGKD5jAfcJ0E",
        "folder": "4h6Y0ehALprvN9Pe",
        "img": "systems/pf2e/icons/default-icons/background.svg",
        "name": "Student of Apotheosis",
        "system": {
