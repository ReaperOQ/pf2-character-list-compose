              "key": "FlatModifier",
              "predicate": [
                {
                  "or": [
                    "target:trait:asura",
                    "target:trait:rakshasa"
                  ]
                },
                {
                  "or": [
                    "action:seek",
                    "action:sense-motive"
                  ]
                }
              ],
              "selector": "perception",
              "value": 1
            }
          ],
          "traits": {
