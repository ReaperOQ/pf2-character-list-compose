    {
      "fileName": "smokeworker-hobgoblin.json",
      "id": "n2eJEjA8pnOMiuCm",
      "name": "Smokeworker Hobgoblin",
      "img": "systems/pf2e/icons/features/ancestry/smokeworker-hobgoblin.webp",
