            "slug": "hobgoblin",
            "uuid": "Compendium.pf2e.ancestries.Item.piNLXUrm9iaGqD2i"
          },
          "description": {
            "value": "<p>Your family have been alchemists, engineers, and scientists for generations, laboring on projects that bring smoke and fire to the field of battle. You gain fire resistance equal to half your level (minimum 1). You automatically succeed at the DC 5 flat check to target a @UUID[Compendium.pf2e.conditionitems.Item.Concealed] creature if that creature is concealed only by smoke.</p>"
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "Resistance",
              "type": "fire",
              "value": "max(1,floor(@actor.level/2))"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": []
          }
        },
        "type": "heritage"
