      "id": "CzOHITB2ihLGqMuJ",
      "name": "Runtboss Hobgoblin",
      "img": "systems/pf2e/icons/features/ancestry/runtboss-hobgoblin.webp",
      "type": "heritage",
      "data": {
        "_id": "CzOHITB2ihLGqMuJ",
