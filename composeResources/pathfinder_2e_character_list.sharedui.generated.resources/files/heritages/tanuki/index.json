      "id": "JtrZ2TcPXP1uIcmd",
      "name": "Virtuous Tanuki",
      "img": "icons/consumables/drinks/alcohol-jug-spirits-brown.webp",
      "type": "heritage",
      "data": {
        "_id": "JtrZ2TcPXP1uIcmd",
