            "uuid": "Compendium.pf2e.ancestries.Item.972EkpJOPv9KkQIW"
          },
          "description": {
            "value": "<p>You have a thick coat of fur that protects you from the cold. You gain cold resistance equal to half your level (minimum 1). You treat environmental cold effects as if they were one step less extreme (incredible cold becomes extreme, extreme cold becomes severe, and so on).</p>"
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "Resistance",
              "type": "cold",
              "value": "max(1,floor(@actor.level/2))"
            }
          ],
