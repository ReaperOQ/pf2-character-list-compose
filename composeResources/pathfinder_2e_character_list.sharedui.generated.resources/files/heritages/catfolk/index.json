    {
      "fileName": "hunting-catfolk.json",
      "id": "1lv7RMp7t5iqeUFT",
      "name": "Hunting Catfolk",
      "img": "systems/pf2e/icons/features/ancestry/hunting-catfolk.webp",
      "type": "heritage",
      "data": {
        "_id": "1lv7RMp7t5iqeUFT",
        "folder": "rHnluMPovHqQZC1m",
        "img": "systems/pf2e/icons/features/ancestry/hunting-catfolk.webp",
        "name": "Hunting Catfolk",
        "system": {
          "ancestry": {
            "name": "Catfolk",
            "slug": "catfolk",
            "uuid": "Compendium.pf2e.ancestries.Item.972EkpJOPv9KkQIW"
          },
          "description": {
            "value": "<p>You come from a long line of skilled hunters and trackers and have a particularly keen sense of smell. You gain imprecise scent with a range of 30 feet. This means you can use your sense of smell to determine a creature's location. The GM will usually double the range if you're downwind from the creature or halve the range if you're upwind.</p>\n<p>In addition, you gain a +2 circumstance bonus to @UUID[Compendium.pf2e.actionspf2e.Item.Track] a creature or object if you've smelled it before.</p>"
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "label": "Hunting Catfolk (Track smelled creatures)",
              "predicate": [
                "action:track",
                "target:previously-smelled"
              ],
              "selector": "survival",
              "type": "circumstance",
              "value": 2
            },
            {
              "acuity": "imprecise",
              "key": "Sense",
              "range": 30,
              "selector": "scent"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": []
          }
        },
        "type": "heritage"
      }
    },
