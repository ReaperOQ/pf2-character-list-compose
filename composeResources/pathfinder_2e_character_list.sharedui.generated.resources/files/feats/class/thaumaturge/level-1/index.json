    {
      "fileName": "haunt-ingenuity.json",
      "id": "iP01b6eyUm4m6KQp",
      "name": "Haunt Ingenuity",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "iP01b6eyUm4m6KQp",
