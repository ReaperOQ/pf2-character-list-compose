    {
      "fileName": "diverse-lore.json",
      "id": "KlqKpeq5OmTRxVHb",
      "name": "Diverse Lore",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "KlqKpeq5OmTRxVHb",
        "folder": "BSQ0GEL1Ln2EoTsR",
