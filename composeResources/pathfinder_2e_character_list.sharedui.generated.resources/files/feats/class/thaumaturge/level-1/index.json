    {
      "fileName": "divine-disharmony.json",
      "id": "fUR72e3t7p2IcqqG",
      "name": "Divine Disharmony",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "fUR72e3t7p2IcqqG",
        "folder": "BSQ0GEL1Ln2EoTsR",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Divine Disharmony",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>From your collection of religious trinkets, you pull out opposing divine objects-such as the religious symbols of two deities that are hated enemies-and combine them in a display that causes discordant clashes of divine energy that are especially distracting to the faithful. Roll your choice of a @Check[deception|defense:will] or @Check[intimidation|defense:will] check against the Will DC of a creature you can see within 60 feet, with the following results. If the creature is particularly devoted to a deity, such as a cleric, celestial, monitor, fiend, or other creature with divine spells, you gain a +2 circumstance bonus to your skill check. The GM might determine that a creature that despises all deities, such as an alghollthu, is unaffected.</p><hr /><p><strong>Critical Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] to your attacks until the end of your next turn.</p>\n<p><strong>Success</strong> The creature is off-guard to your attacks until the end of your current turn.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Dark Archive (Remastered)"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "predicate": [
                "action:divine-disharmony",
                {
                  "or": [
                    "target:trait:cleric",
                    "target:trait:fiend",
                    "target:trait:monitor",
                    "target:trait:celestial",
                    "target:caster:tradition:divine"
                  ]
                }
              ],
              "selector": [
                "intimidation",
                "deception"
              ],
              "type": "circumstance",
              "value": 2
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "divine",
              "esoterica",
              "manipulate",
              "thaumaturge"
            ]
          }
        },
