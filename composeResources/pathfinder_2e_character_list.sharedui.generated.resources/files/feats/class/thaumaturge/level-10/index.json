        "name": "Share Weakness",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You are Exploiting a creature's Vulnerability using mortal weakness.</p><hr /><p>You select an object from your esoterica that has great personal value to you, such as a locket or treasured ring, and you grant it to an adjacent ally, establishing a personal link that allows your ally to affect an enemy as if they were you. The ally's Strikes apply the weakness from your mortal weakness the same way your Strikes do. This benefit ends when your @UUID[Compendium.pf2e.actionspf2e.Item.Exploit Vulnerability] ends or you Share Weakness again.</p>"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Exploit Vulnerability"
              },
              {
                "value": "mortal weakness"
              }
            ]
          },
