    {
      "fileName": "fish-from-the-falls-edge.json",
      "id": "tv0TX0DiDg2lDMOl",
      "name": "Fish From the Falls' Edge",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "tv0TX0DiDg2lDMOl",
        "folder": "jzBapiojOiHRHdxB",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Fish From the Falls' Edge",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per day</p>\n<p><strong>Trigger</strong> A living creature within 30 feet would die.</p>\n<p><strong>Requirements</strong> Your divine spark is empowering one of your ikons.</p><hr /><p>Seeing your ally fall, you let out a cry, sending your divine spark to them temporarily to keep them from tumbling down the River of Souls. You prevent the triggering creature from dying and restore @Damage[5d8[vitality,healing]|shortLabel] Hit Points to them. The ally is invigorated by the touch of your divine power, gaining a +1 status bonus to their saving throws and AC for 1 round.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Fish From the Falls' Edge]</p>\n<p>Your divine spark remains with your ally, preventing you from gaining any of your ikons' immanence effects until the start of your next turn, when it returns to an ikon of your choice.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "day"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": []
          },
