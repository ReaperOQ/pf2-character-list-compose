    {
      "fileName": "sabotage.json",
      "id": "vDeG0N4kzTBDTC2b",
      "name": "Sabotage",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "vDeG0N4kzTBDTC2b",
        "folder": "SRyOhV7pAy46Ewm3",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Sabotage",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You have a free hand.</p>\n<hr />\n<p>You subtly damage others' equipment. Choose one item that a creature within your reach wields or carries. The item must have moving parts that you could possibly sabotage (a shortbow could be sabotaged, but a longsword could not). Attempt a @Check[thievery|defense:reflex] check against the Reflex DC of the creature. Damage dealt by Sabotage can't take the item below its Broken Threshold.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal damage equal to 4 x your Thievery proficiency bonus.</p>\n<p><strong>Success</strong> You deal damage equal to double your Thievery proficiency bonus.</p>\n<p><strong>Critical Failure</strong> The item is temporarily immune to your Sabotage for 1 day.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "incapacitation",
              "rogue"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "class"
