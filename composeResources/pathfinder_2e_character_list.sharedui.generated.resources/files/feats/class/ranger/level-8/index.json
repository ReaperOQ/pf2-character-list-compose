        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You aim for your prey's weak spots, making your shot more challenging but dealing more damage if you hit. Make a ranged Strike against your hunted prey at a –2 penalty. You gain a +4 circumstance bonus to damage on that Strike. This bonus increases to +6 at 11th level and +8 at 15th level.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "weapon specialization"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
              "key": "RollOption",
              "option": "deadly-aim",
              "toggleable": true
            },
            {
              "key": "FlatModifier",
              "predicate": [
                "deadly-aim"
              ],
              "selector": "attack",
              "type": "circumstance",
              "value": -2
            },
            {
              "key": "FlatModifier",
              "predicate": [
                "deadly-aim"
              ],
              "selector": "strike-damage",
              "type": "circumstance",
              "value": "match(when(btwn(@actor.level, 8, 10), 4), when(btwn(@actor.level, 11, 14), 6), when(gte(@actor.level, 15), 8))"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "flourish",
              "ranger"
            ]
          }
        },
