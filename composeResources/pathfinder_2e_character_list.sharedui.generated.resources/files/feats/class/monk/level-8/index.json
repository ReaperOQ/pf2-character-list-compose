    {
      "fileName": "wake-to-strife.json",
      "id": "iAtdHXY6wqL7QRBb",
      "name": "Wake to Strife",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "iAtdHXY6wqL7QRBb",
        "folder": "vIv76ARzujbUOS1T",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Wake to Strife",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 2
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> A creature within your reach is @UUID[Compendium.pf2e.conditionitems.Item.Prone] or swimming.</p><hr /><p>You summon the explosive power of a geyser beneath a foe. The required creature must attempt a @Check[fortitude|against:class] save against your class DC as elemental water confounds their senses; if the creature is prone, they can Stand as a free action.</p><hr /><p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 1}.</p>\n<p><strong>Failure</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2}. If you have a free hand and they are not larger than you, you can attempt an Athletics check to @UUID[Compendium.pf2e.actionspf2e.Item.Grapple] them as a free action.</p>\n<p><strong>Critical Failure</strong> As failure, but if you succeed at the Athletics check to Grapple them, you get a critical success instead.</p>"
          },
