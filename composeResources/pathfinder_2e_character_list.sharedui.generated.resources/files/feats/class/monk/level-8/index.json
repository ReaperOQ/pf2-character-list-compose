    {
      "fileName": "tangled-forest-stance.json",
      "id": "2tUdsoPEnW9yS8so",
      "name": "Tangled Forest Stance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "2tUdsoPEnW9yS8so",
        "folder": "vIv76ARzujbUOS1T",
