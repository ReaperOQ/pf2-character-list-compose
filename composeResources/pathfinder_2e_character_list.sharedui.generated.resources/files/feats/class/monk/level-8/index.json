    {
      "fileName": "wild-winds-initiate.json",
      "id": "CL9pFxxMXqzIyg4j",
      "name": "Wild Winds Initiate",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "CL9pFxxMXqzIyg4j",
        "folder": "vIv76ARzujbUOS1T",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Wild Winds Initiate",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You learn a stance that lets you attack from a distance. You gain the @UUID[Compendium.pf2e.spells-srd.Item.Wild Winds Stance] qi spell.</p>\n<p>While entering the stance is a qi spell, the wind crash Strikes the stance grants are not, so you can use them as often as you like while in the stance.</p>"
          },
