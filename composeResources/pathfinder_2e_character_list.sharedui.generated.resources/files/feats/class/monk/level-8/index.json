    {
      "fileName": "snakebirds-shadow.json",
      "id": "GEonUnKYVyWoHh1O",
      "name": "Snakebird's Shadow",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "GEonUnKYVyWoHh1O",
        "folder": "vIv76ARzujbUOS1T",
        "img": "icons/sundries/books/book-red-exclamation.webp",
