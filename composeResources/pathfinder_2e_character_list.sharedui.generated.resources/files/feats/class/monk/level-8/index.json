          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You learn a mystical stance that transforms your qi into sticky smoke that shrouds your limbs. You gain the @UUID[Compendium.pf2e.spells-srd.Item.Clinging Shadows Stance] qi spell. While entering the stance is a qi spell, the shadow grasp attacks it grants are not, so you can use them as often as you like while in the stance.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
