      "name": "Underworld Investigator",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "pgIrr8xrlCXbRAeo",
        "folder": "6R0mUPnUZrsI8pL3",
