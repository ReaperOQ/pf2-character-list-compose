    {
      "fileName": "not-so-fast.json",
      "id": "46mkvetP7cdi7LO0",
      "name": "Not So Fast!",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "46mkvetP7cdi7LO0",
        "folder": "yx1Br5S2XJCuXqjq",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Not So Fast!",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature within your reach leaves a square during a move action it's using.</p>\n<p><strong>Requirements</strong> You are in @UUID[Compendium.pf2e.feats-srd.Item.Hampering Stance].</p><hr /><p>You lash out when foes try to get past you, possibly stopping them in their tracks. Make a melee Strike against the triggering creature. The Strike gains the following additional results.</p><hr /><p><strong>Critical Success</strong> The target's movement is disrupted.</p>\n<p><strong>Success</strong> The target takes a –10-foot circumstance penalty to its Speed for the rest of its triggering movement. This penalty might cause the triggering creature's movement to end immediately based on its affected Speed.</p>\n<p><strong>Failure</strong> As success, but the target instead takes a –5-foot circumstance penalty to its Speed.</p>\n<p><strong>Critical Failure</strong> The target is unaffected.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Hampering Stance"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Battlecry!"
          },
          "rules": [],
          "subfeatures": {
            "proficiencies": {},
            "senses": {},
            "suppressedFeatures": []
          },
          "traits": {
