            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>You touch a weapon and bring it into concordance with your deity. For 1 round, that weapon gains your holy or unholy trait. It also deals an additional 2d6 spirit damage to creatures of the opposed trait. For example, if you are holy, the weapon would deal an extra 2d6 spirit damage to unholy creatures.</p>\n<p>If you use Sanctify Armament again, any previous use of it expires.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: Sanctify Armament]</p>"
          },
          "frequency": {
            "max": 1,
            "per": "round",
            "value": 1
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "holy or unholy trait"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [],
