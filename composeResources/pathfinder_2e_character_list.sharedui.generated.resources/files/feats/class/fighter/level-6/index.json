    {
      "fileName": "disarming-stance.json",
      "id": "1p5ErCp33nGOzEsk",
      "name": "Disarming Stance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "1p5ErCp33nGOzEsk",
        "folder": "i69cshtrOWvVMzxH",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Disarming Stance",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You are wielding a single one-handed melee weapon and hold nothing else in your hands.</p>\n<hr />\n<p>You adopt a fencing stance that improves your control over your weapon. While you are in this stance, you gain a +1 circumstance bonus to Athletics checks to @UUID[Compendium.pf2e.actionspf2e.Item.Disarm] and a +2 circumstance bonus to your Reflex DC when defending against checks to Disarm you. In addition, you can attempt to Disarm creatures up to two sizes larger than you.</p>"
          },
          "level": {
            "value": 6
          },
          "prerequisites": {
            "value": [
              {
                "value": "trained in Athletics"
              }
            ]
          },
          "publication": {
            "license": "ORC",
