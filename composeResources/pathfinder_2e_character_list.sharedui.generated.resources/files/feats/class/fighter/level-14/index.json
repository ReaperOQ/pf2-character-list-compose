    },
    {
      "fileName": "guiding-finish.json",
      "id": "9t6Kfk8Yw8WJYY8Z",
      "name": "Guiding Finish",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "9t6Kfk8Yw8WJYY8Z",
        "folder": "eKI7L5573ZDo3hSK",
