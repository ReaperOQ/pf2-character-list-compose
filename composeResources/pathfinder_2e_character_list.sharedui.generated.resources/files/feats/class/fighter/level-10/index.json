    {
      "fileName": "crashing-slam.json",
      "id": "yTh9QwAf0hadP91j",
      "name": "Crashing Slam",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "yTh9QwAf0hadP91j",
        "folder": "2VfT9SPI0JDUPeCl",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Crashing Slam",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You can dash your foe to the ground with a single blow. If the Strike you make with @UUID[Compendium.pf2e.feats-srd.Item.Slam Down] hits, you can automatically get a critical success on your @UUID[Compendium.pf2e.actionspf2e.Item.Trip] instead of rolling a check. (Both the Strike and Trip still count toward your multiple attack penalty).</p>\n<p>If you used a two-handed melee weapon for the Strike, you can use the weapon's damage die size instead of the regular die size for the damage from a critical Trip.</p>"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Slam Down"
              }
            ]
          },
