    {
      "fileName": "leading-dance.json",
      "id": "ZHPSASbvbbshq1zG",
      "name": "Leading Dance",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "ZHPSASbvbbshq1zG",
        "folder": "RXB0Yz1ukXYfyRAG",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Leading Dance",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You are adjacent to an enemy.</p><hr /><p>You sweep your foe into your dance. Attempt a @Check[performance|defense:will] check against an adjacent enemy's Will DC.</p><hr /><p><strong>Critical Success</strong> Your foe is swept up in your dance. You both move up to 10 feet in the same direction, remaining adjacent to one another. Your movement doesn't trigger reactions from the target (and the target's movement doesn't trigger reactions because it's forced movement).</p>\n<p><strong>Success</strong> As critical success, but you both move only 5 feet.</p>\n<p><strong>Failure</strong> The foe doesn't follow your steps. You can move 5 feet if you choose, but this movement triggers reactions normally.</p>\n<p><strong>Critical Failure</strong> You stumble, falling @UUID[Compendium.pf2e.conditionitems.Item.Prone] in your space.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "trained in Performance"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core 2"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "bravado",
              "move",
              "swashbuckler"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "class"
    },
