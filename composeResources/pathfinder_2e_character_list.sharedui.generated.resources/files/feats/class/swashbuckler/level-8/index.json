                "flashy-dodge"
              ],
              "selector": "reflex",
              "type": "circumstance",
              "value": 2
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "swashbuckler"
            ]
          }
        },
        "type": "feat"
      },
