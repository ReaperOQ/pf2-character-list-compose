              "mergeable": true,
              "option": "finisher",
              "suboptions": [
                {
                  "label": "PF2E.SpecificRule.Swashbuckler.Finisher.Bleeding",
                  "value": "bleeding"
                }
              ],
              "toggleable": true
            },
            {
              "category": "persistent",
              "damageType": "bleed",
              "diceNumber": "@actor.flags.system.swashbuckler.preciseStrike",
              "dieSize": "d6",
              "key": "DamageDice",
              "predicate": [
                "finisher:bleeding",
                {
                  "or": [
                    "item:melee",
                    {
                      "and": [
                        "feat:flying-blade",
                        "item:thrown",
