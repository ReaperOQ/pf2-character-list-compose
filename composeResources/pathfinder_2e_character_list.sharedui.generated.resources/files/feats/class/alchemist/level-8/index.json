      "name": "Improved Invigorating Elixir",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "J9LjIYPyUmOim5r7",
        "folder": "feOsShWg4TUR6E4C",
