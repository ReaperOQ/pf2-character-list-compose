      "id": "k72W0qMXsX5ekJTF",
      "name": "Reflect Spell",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "k72W0qMXsX5ekJTF",
