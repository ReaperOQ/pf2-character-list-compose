    {
      "fileName": "bullet-dancer-burn.json",
      "id": "uc6JcNrI31wzSC2h",
      "name": "Bullet Dancer Burn",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "uc6JcNrI31wzSC2h",
        "folder": "UQdIYofnLbcraxlJ",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Bullet Dancer Burn",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're wielding a simple combination weapon or an attached bayonet or reinforced stock.</p><hr /><p>The fiery blaze of your weapon shocks your enemies. While in @UUID[Compendium.pf2e.actionspf2e.Item.Bullet Dancer Stance], when you successfully Strike an opponent with the melee form of a combination weapon or a bayonet or reinforced stock attached to a simple firearm, the next ranged Strike you make against that opponent doesn't trigger reactions that would trigger on a ranged attack, such as Reactive Strike. While in Bullet Dancer Stance, when you make a successful ranged Strike against an opponent within your melee reach using a firearm, the next melee attack against that opponent with that weapon or a weapon attached to it deals an additional 1 fire damage and 1 persistent fire damage per weapon damage die of the attached firearm.</p>\n<p>The benefit on your next Strike from either use of Bullet Dancer Burn is lost if not used by the end of your next turn.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Bullet Dancer Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Guns & Gears"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
