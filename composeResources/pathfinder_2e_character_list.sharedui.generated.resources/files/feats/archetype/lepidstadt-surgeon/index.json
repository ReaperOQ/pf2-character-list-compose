    {
      "fileName": "in-lightning-life.json",
      "id": "1RQLf09kpOO6ljmb",
      "name": "In Lightning, Life",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "1RQLf09kpOO6ljmb",
        "folder": "rKTkNlqyaQuLy3sq",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "In Lightning, Life",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Frequency</strong> once per 10 minutes</p>\n<p><strong>Requirements</strong> You're wearing or holding a @UUID[Compendium.pf2e.equipment-srd.Item.Healer's Toolkit].</p><hr /><p>\"In lightning, there is life.\" This lesson is whispered throughout Lepidstadt, and you can put it to practical use. You have integrated a miniature Stasian coil into your healer's toolkit. You use the coil to gently shock a willing or @UUID[Compendium.pf2e.conditionitems.Item.Unconscious] ally within your reach, who gains 2d4 temporary Hit Points from the jolt. These temporary Hit Points last for 1 minute. These temporary Hit Points increase by 1d4 at 8th level and every 4 levels thereafter.</p>\n<p>@UUID[Compendium.pf2e.feat-effects.Item.Effect: In Lightning, Life]</p>\n<p>A creature that has resistance or immunity to electricity is immune to this ability, and a creature that received temporary Hit Points from In Lightning, Life is temporarily immune to it for 24 hours.</p>"
          },
          "frequency": {
            "max": 1,
            "per": "PT10M"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Lepidstadt Surgeon Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Rival Academies"
          },
          "rules": [],
          "selfEffect": {
            "name": "Effect: In Lightning, Life",
            "uuid": "Compendium.pf2e.feat-effects.Item.Effect: In Lightning, Life"
          },
          "subfeatures": {
            "proficiencies": {},
            "senses": {},
            "suppressedFeatures": []
          },
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "concentrate",
              "electricity",
              "healing",
              "manipulate"
            ]
          }
        },
        "type": "feat"
      },
