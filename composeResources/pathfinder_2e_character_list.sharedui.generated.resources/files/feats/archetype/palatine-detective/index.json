    {
      "fileName": "open-the-blazing-eye.json",
      "id": "lFc7HTNUCUemzSiV",
      "name": "Open the Blazing Eye",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "lFc7HTNUCUemzSiV",
        "folder": "3oq6iE8irLjlLcEE",
