      "id": "cIClNoUqtX2SGWfz",
      "name": "Greater Esoteric Spellcasting",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "cIClNoUqtX2SGWfz",
        "folder": "3oq6iE8irLjlLcEE",
