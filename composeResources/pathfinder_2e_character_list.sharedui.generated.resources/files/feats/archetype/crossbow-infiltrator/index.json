    {
      "fileName": "infiltrators-reload.json",
      "id": "2RwRguv3J0CbzjNg",
      "name": "Infiltrator's Reload",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "2RwRguv3J0CbzjNg",
        "folder": "lcAbFFHgv56Zo5C3",
