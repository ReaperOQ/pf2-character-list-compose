            ]
          }
        },
        "type": "feat"
      },
      "level": 10,
      "category": "class"
    },
    {
      "fileName": "infiltrators-blitz.json",
      "id": "HRg8cnxy0uiJ1pqE",
      "name": "Infiltrator's Blitz",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "HRg8cnxy0uiJ1pqE",
        "folder": "lcAbFFHgv56Zo5C3",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Infiltrator's Blitz",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 3
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're not @UUID[Compendium.pf2e.conditionitems.Item.Fatigued].</p><hr /><p>Though your training is meant to ensure you don't get caught by your enemies, your missions are often high risk, and sometimes the only option you have left when things go wrong is to unleash a blistering torrent of violence while running away as fast as possible.</p>\n<p>You can attempt to @UUID[Compendium.pf2e.actionspf2e.Item.Escape] any effect that is currently immobilizing you. You gain a +10-foot circumstance bonus to your Speed and can Stride up to three times. At any point during each of these Strides, you can Strike with a weapon you have familiarity with from this archetype and can then immediately Interact to reload that weapon.</p>\n<p>After using Infiltrator's Blitz, you become fatigued for 1 minute.</p>"
          },
          "level": {
            "value": 16
          },
          "prerequisites": {
            "value": [
              {
                "value": "Crossbow Infiltrator Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Battlecry!"
          },
          "rules": [],
