    {
      "fileName": "infiltration-assassination.json",
      "id": "8GJOPesRzytyouAU",
      "name": "Infiltration Assassination",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "8GJOPesRzytyouAU",
        "folder": "lcAbFFHgv56Zo5C3",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Infiltration Assassination",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 2
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're wearing a loaded gauntlet bow.</p><hr /><p>With a high-priority target in reach, you quickly move to eliminate them. Make a melee Strike using your gauntlet bow as a gauntlet. If the Strike is successful, you automatically latch onto the target, giving them the @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] condition, then make a ranged Strike against them with your gauntlet bow. This Strike does not trigger reactions normally triggered by ranged attacks. If you are holding or wearing an injury poison, you can apply it to the bolt used in the attack as a free action before making the ranged Strike.</p>"
          },
          "level": {
            "value": 10
          },
          "prerequisites": {
            "value": [
              {
                "value": "Crossbow Infiltrator Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Battlecry!"
          },
