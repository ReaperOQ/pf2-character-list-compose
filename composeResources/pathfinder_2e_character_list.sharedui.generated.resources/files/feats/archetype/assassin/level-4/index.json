          "category": "class",
          "description": {
            "value": "<p>You excel at quickly dispatching your foes. When you Strike an @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] foe with a weapon that has the backstabber weapon trait, you deal 2 extra precision damage instead of 1. If the weapon is a <em>+3 weapon</em>, you deal 4 extra precision damage instead of 2.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
