    {
      "fileName": "only-my-doom-may-claim-me.json",
      "id": "I5swIFsr4UOAEBvv",
      "name": "Only My Doom May Claim Me",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "I5swIFsr4UOAEBvv",
        "folder": "lO7eEXPM4mLROj2k",
