    {
      "fileName": "illuminating-stories.json",
      "id": "yRT94fGPaS1M9f9I",
      "name": "Illuminating Stories",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "yRT94fGPaS1M9f9I",
        "folder": "ecygCZjU63FUN433",
