    {
      "fileName": "the-dead-tell-tales.json",
      "id": "6WsUotDsr7TUVDkE",
      "name": "The Dead Tell Tales",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "6WsUotDsr7TUVDkE",
        "folder": "ecygCZjU63FUN433",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "The Dead Tell Tales",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>New campfire chroniclers are inundated with the stories of the ghosts below Pulura's Fall and the lessons learned there. You have resistance equal to your level to spirit and void damage caused by a haunt, spirit, or incorporeal undead. The first time you take damage from a haunt or spirit, you learn the general story of its origin (such as the type of tragedy that caused a ghost to linger or what a spirit represents).</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Campfire Chronicler Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Rival Academies"
          },
