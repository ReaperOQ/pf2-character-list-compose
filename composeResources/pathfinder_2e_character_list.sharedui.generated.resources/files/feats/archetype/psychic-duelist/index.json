    {
      "fileName": "psychic-duelist-dedication.json",
      "id": "xKKyS9nEQqolJ0SF",
      "name": "Psychic Duelist Dedication",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "xKKyS9nEQqolJ0SF",
