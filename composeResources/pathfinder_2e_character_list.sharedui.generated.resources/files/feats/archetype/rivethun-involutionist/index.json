    {
      "fileName": "rivethun-involutionist-dedication.json",
      "id": "uiX2xS6vTBRBjxdA",
      "name": "Rivethun Involutionist Dedication",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "uiX2xS6vTBRBjxdA",
        "folder": "eWCuI6reeaKCuA1z",
