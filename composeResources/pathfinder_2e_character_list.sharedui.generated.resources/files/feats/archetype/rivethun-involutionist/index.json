    {
      "fileName": "specialized-spirit-companion.json",
      "id": "lffwKBOaUgWUC9KJ",
      "name": "Specialized Spirit Companion",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "lffwKBOaUgWUC9KJ",
        "folder": "eWCuI6reeaKCuA1z",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Specialized Spirit Companion",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>Your animal companion gains a unique specialization, spirit-blessed. Thanks to the blessing bestowed upon it by the spirits of this world. If your animal companion already has the spirit-blessed specialization, it gains one additional specialization of your choice.</p>\n<p><strong>Spirit-blessed:</strong> Your companion is capable of harming wayward spirits, ghosts, and other incorporeal creatures as easy as if they were made of flesh and bone. Your companion's Strikes all gain the effects of the ghost touch property rune.</p><hr /><p><strong>Special</strong> You can select this feat up to three times. Each time, add a different specialization to your companion. It's first specialization must be spirit-blessed.</p>"
          },
          "level": {
            "value": 14
          },
          "maxTakable": 3,
          "prerequisites": {
            "value": [
              {
                "value": "Spirit Companion"
              },
              {
                "value": "Incredible Companion"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Divine Mysteries"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype"
            ]
          }
        },
        "type": "feat"
      },
