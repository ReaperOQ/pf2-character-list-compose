        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p>Your tongue darts out in search of refreshment. Choose a liquid container of up to light Bulk within reach of your lash, such as a potion or elixir. The container must be held or in the open, not stowed in a pack or bandoleer. If the container is unattended or held by a willing ally, you Interact to drink the contents. If the container is held by an unwilling creature, you must succeed on a check using your unarmed attack modifier or Thievery modifier against the creature's Reflex DC to drink the contents; this adds the attack trait.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
