    {
      "fileName": "lassoing-lash.json",
      "id": "9O7DLcXVXpwLVXI6",
      "name": "Lassoing Lash",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "9O7DLcXVXpwLVXI6",
        "folder": "WaWgZeXPbHxSltnE",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Lassoing Lash",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> The target can't be more than one size larger than you.</p><hr /><p>You quickly wrap your lash around an opponent and pull them toward you. Attempt an [[/act grapple]] check against the Fortitude DC of a target within your lash's reach.</p><hr /><p><strong>Critical Success</strong> You pull the target to any open space adjacent to you.</p>\n<p><strong>Success</strong> You pull the target to the nearest open space adjacent to you.</p>\n<p><strong>Critical Failure</strong> You misjudge your leverage and fall @UUID[Compendium.pf2e.conditionitems.Item.Prone].</p><hr /><p><strong>Special</strong> If you have the Titan Wrestler feat, you can target a creature up to two sizes larger than you, or up to three sizes larger than you if you're legendary in Athletics.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Thlipit Contestant Dedication"
              },
              {
                "value": "trained in Athletics"
              }
            ]
          },
          "publication": {
            "license": "ORC",
