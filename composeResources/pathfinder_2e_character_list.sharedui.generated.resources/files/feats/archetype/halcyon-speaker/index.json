    {
      "fileName": "speak-for-the-gravelands.json",
      "id": "Ogso0WqodeFG27L1",
      "name": "Speak for the Gravelands",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
