      "name": "Vellumis Excision",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "EPqhCeCo1uOvJSTZ",
        "folder": "wXS0eAMOesKusxel",
