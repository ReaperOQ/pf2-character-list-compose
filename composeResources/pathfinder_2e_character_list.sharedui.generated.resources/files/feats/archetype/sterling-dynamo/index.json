      "fileName": "beast-dynamo-howl.json",
      "id": "K0x90HNHi5hONdDl",
      "name": "Beast Dynamo Howl",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "K0x90HNHi5hONdDl",
