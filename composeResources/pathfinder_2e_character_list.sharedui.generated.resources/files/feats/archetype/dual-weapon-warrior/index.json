    },
    {
      "fileName": "dual-thrower.json",
      "id": "zfTmb78yGZzNpgU3",
      "name": "Dual Thrower",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "zfTmb78yGZzNpgU3",
        "folder": "9o8mpZr1vpuQu4va",
