    {
      "fileName": "phase-bullet.json",
      "id": "nY8HtHNJMqP0hz3v",
      "name": "Phase Bullet",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "nY8HtHNJMqP0hz3v",
        "folder": "8scpZnradJHp2Mwl",
