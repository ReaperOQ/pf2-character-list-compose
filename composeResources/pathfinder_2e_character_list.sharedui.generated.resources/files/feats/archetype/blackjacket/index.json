    {
      "fileName": "nothing-personal.json",
      "id": "gDvLmqxAtxY3LVaH",
      "name": "Nothing Personal",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "gDvLmqxAtxY3LVaH",
        "folder": "eLN5fg0dn0xdQGZZ",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Nothing Personal",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You have an active course of action planned.</p><hr /><p>When you're on a job, you can't allow anyone to stop you. Designate a single creature you can see as being an impediment to your active course of action. The first time you Strike your impediment in a round, you deal an extra die of weapon damage. At 14th level, this increases to two extra dice, and at 20th level, this increases to three extra dice.</p>\n<p>You can have only one creature designated as an impediment at a time. If you use Nothing Personal against a creature when you already have a creature designated, the prior creature loses the designation, and the new impediment gains the designation. Otherwise, your designation lasts for 1 hour.</p>"
          },
          "level": {
            "value": 8
          },
          "prerequisites": {
            "value": [
              {
                "value": "Mercenary Motivation"
              }
            ]
          },
