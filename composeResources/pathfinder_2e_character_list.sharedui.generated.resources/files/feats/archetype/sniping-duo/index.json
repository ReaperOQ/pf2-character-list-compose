      "name": "Vantage Shot",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "qXWcmyHLkMlzRffC",
        "folder": "8doC5H2PAm5u9qvc",
