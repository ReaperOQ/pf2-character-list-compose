      "data": {
        "_id": "svBQNCS2ZCPlKm6f",
        "folder": "e4vGOrE8QgzFscPk",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Blood Calls Blood",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> You fail a flat check to Cast a Spell or your spell would be disrupted by another creature's reaction.</p><hr /><p>The magical potency of your blood will not be denied. You finish Casting the Spell, then become @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1} or increase the value of your drained condition by 1.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
