    {
      "fileName": "hammer-quake.json",
      "id": "CR9NcAIPTT4oWSEy",
      "name": "Hammer Quake",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "CR9NcAIPTT4oWSEy",
        "folder": "ZkeJbX2kE03A4XrN",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Hammer Quake",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 3
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Requirements</strong> You're wielding a non-finesse melee weapon in two hands.</p><hr /><p>You smash the ground with your weapon, knocking nearby creatures to the ground. Choose a square within your reach, including your own space. If there's an enemy in the chosen square, you can Strike that enemy with your two-handed weapon. Regardless of whether you attempted a Strike, you then attempt to @UUID[Compendium.pf2e.actionspf2e.Item.Trip] every enemy in the chosen square plus each square adjacent to that square, ignoring Trip's requirement that you have a hand free.</p>\n<p>Hammer Quake counts as three attacks toward your multiple attack penalty, but the penalty doesn't increase until after you've made the Strike, if any, and all the Trip attempts.</p>"
          },
          "level": {
            "value": 14
          },
          "prerequisites": {
            "value": [
              {
                "value": "Mauler Dedication"
              }
            ]
          },
