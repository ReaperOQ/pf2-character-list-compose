          },
          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p><strong>Trigger</strong> An improvised weapon that you are wielding becomes broken as a result of a critical success on an Improvised Pummel.</p>\n<hr />\n<p>The improvised weapon shatters, destroying it completely but dealing an additional @Damage[3d6[piercing]] damage to the creature you hit with the Improvised Pummel. This extra damage you apply on the critical hit doesn't double from the critical hit, as normal.</p>"
          },
          "level": {
            "value": 10
