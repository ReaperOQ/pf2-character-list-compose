    {
      "fileName": "shattering-strike-weapon-improviser.json",
      "id": "B7VMXObJSNVI0ZGJ",
      "name": "Shattering Strike (Weapon Improviser)",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "B7VMXObJSNVI0ZGJ",
        "folder": "vo57FQBynPIhMFlT",
