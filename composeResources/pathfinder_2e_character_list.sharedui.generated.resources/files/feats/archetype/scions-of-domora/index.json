          "actions": {
            "value": null
          },
          "category": "class",
          "description": {
            "value": "<p>You gain a spirit guide ally. Your familiar takes on the form of a spirit guide specific familiar.</p><hr /><p><strong>Special</strong> You can take Scion of Domora Dedication even if you have the @UUID[Compendium.pf2e.feats-srd.Item.Familiar Master Dedication] and have not taken two other @UUID[Compendium.pf2e.journals.JournalEntry.vx5FGEG34AxI2dow.JournalEntryPage.yaR8E2drX6pFUFCK]{Familiar Master} feats. You can't select another dedication feat until you have gained at least two other feats from the @UUID[Compendium.pf2e.journals.JournalEntry.vx5FGEG34AxI2dow.JournalEntryPage.J0AfK0jJgS5WxhCE]{scion of Domora} or familiar master archetypes.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Familiar Master Dedication"
              },
              {
                "value": "you have befriended a spirit guide and it bonded with you using its Bond with Mortal ability."
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Adventure Path: Gatewalkers"
          },
          "rules": [],
          "traits": {
            "rarity": "rare",
            "value": [
              "archetype",
              "dedication"
            ]
          }
