    {
      "fileName": "power-slide.json",
      "id": "SXXyAwe9FGBwhJIW",
      "name": "Power Slide",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "SXXyAwe9FGBwhJIW",
        "folder": "AG676keg35xId0fn",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Power Slide",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 1
          },
          "category": "skill",
          "description": {
            "value": "<p><strong>Requirements</strong> You are piloting a vehicle.</p><hr /><p>You throw the vehicle into a barely controlled skid, turning sharply to evade pursuit or bring your weapons to bear. You Drive with a –2 penalty to your piloting check, gaining the effects of the Drive action for the same number of actions you spent to Power Slide. At the end of the movement, if you succeed, you can turn the vehicle up to 90 degrees. If you critically succeed at your piloting check, you can instead turn the vehicle up to 180 degrees.</p>"
          },
          "level": {
            "value": 4
          },
          "prerequisites": {
            "value": [
              {
                "value": "Trick Driver Dedication"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Guns & Gears"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "archetype",
              "move",
              "reckless"
            ]
          }
        },
        "type": "feat"
      },
      "level": 4,
      "category": "skill"
    },
