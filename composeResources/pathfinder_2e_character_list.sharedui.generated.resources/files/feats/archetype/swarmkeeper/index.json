      "name": "Pyre Ant Sting",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "mwPOOTtELS4X7reC",
        "folder": "xJd21ECSMdugkuI2",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Pyre Ant Sting",
        "system": {
