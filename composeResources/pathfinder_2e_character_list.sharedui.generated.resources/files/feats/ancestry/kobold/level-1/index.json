        "folder": "DHDisl3wodueFQqb",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Cringe",
        "system": {
          "actionType": {
            "value": "reaction"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Trigger</strong> A creature you are aware of critically succeeds on a Strike against you and would deal damage to you.</p><hr /><p>With pitiful posturing, you cause your foe to pull back a deadly attack. The attacking creature takes a circumstance penalty to the damage of the triggering Strike equal to your level + 2. This penalty applies after doubling the damage for a critical hit. The attacker is then immune to your Cringe for 24 hours.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
