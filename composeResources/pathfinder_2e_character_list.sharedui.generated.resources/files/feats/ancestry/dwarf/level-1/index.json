              "path": "system.skills.religion.rank",
              "value": 1
            },
            {
              "key": "GrantItem",
              "uuid": "Compendium.pf2e.feats-srd.Item.Additional Lore"
            }
          ],
          "traits": {
            "rarity": "common",
            "value": [
              "dwarf"
            ]
          }
        },
        "type": "feat"
      },
