    {
      "fileName": "stonemasons-eye.json",
      "id": "HOUHs5rahwIsQoBf",
      "name": "Stonemason's Eye",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "HOUHs5rahwIsQoBf",
