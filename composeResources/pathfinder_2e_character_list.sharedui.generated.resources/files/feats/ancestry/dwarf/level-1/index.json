      "id": "z92LsdpE98QdwILa",
      "name": "Adaptive Vision",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "z92LsdpE98QdwILa",
        "folder": "kTu1AMjR6p5abNSc",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Adaptive Vision",
        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Access</strong> You are from Dongun Hold or Alkenstar.</p><hr /><p>After years of using black powder weaponry in dimly lit spaces, you've become accustomed to dazzling flashes of light and sudden shifts in illumination. You gain a +1 circumstance bonus to saving throws against visual effects. If you roll a success on a saving throw against a visual effect, you get a critical success instead.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Guns & Gears"
          },
          "rules": [
            {
              "key": "FlatModifier",
              "predicate": [
                "item:trait:visual"
              ],
              "selector": "saving-throw",
              "type": "circumstance",
              "value": 1
            },
            {
              "adjustment": {
                "success": "one-degree-better"
              },
              "key": "AdjustDegreeOfSuccess",
              "predicate": [
                "visual"
              ],
              "selector": "saving-throw",
              "type": "save"
            },
            {
              "key": "Note",
              "outcome": [
                "success"
              ],
              "predicate": [
                "item:trait:visual"
              ],
              "selector": "saving-throw",
              "text": "When you roll a success on a save against a visual effect, you get a critical success instead.",
              "title": "{item|name}"
            }
          ],
          "traits": {
            "rarity": "uncommon",
            "value": [
              "dwarf"
            ]
          }
        },
        "type": "feat"
      },
      "level": 1,
      "category": "ancestry"
    },
    {
      "fileName": "clan-pistol.json",
