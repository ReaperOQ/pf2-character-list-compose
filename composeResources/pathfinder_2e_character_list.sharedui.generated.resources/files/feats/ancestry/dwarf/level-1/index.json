    {
      "fileName": "fire-savvy.json",
      "id": "W5hgaJvaCrTKfYbC",
      "name": "Fire Savvy",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "W5hgaJvaCrTKfYbC",
        "folder": "kTu1AMjR6p5abNSc",
