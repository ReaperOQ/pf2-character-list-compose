            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p><strong>Frequency</strong> three times per day</p><hr /><p>Putting on a new face offers a great way to get a fresh perspective on life. When you Change Shape into your everyday form, you gain the effects of a 3rd-rank @UUID[Compendium.pf2e.spells-srd.Item.Illusory Disguise] for 1 hour or until you shift back, whichever comes first, except it's a polymorph effect rather than an illusion. However, your transformations can be broken with a good shock; if you gain the @UUID[Compendium.pf2e.conditionitems.Item.Frightened] or @UUID[Compendium.pf2e.conditionitems.Item.Stunned] condition while transformed, your transformation ends, returning you to your tanuki form, and your confidence is so shaken you can't attempt to resume that specific disguise again until your next daily preparations.</p>"
          },
          "frequency": {
            "max": 3,
            "per": "day"
          },
          "level": {
            "value": 9
          },
          "prerequisites": {
            "value": [
              {
                "value": "Everyday Form"
              }
            ]
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [],
          "traits": {
            "rarity": "common",
            "value": [
              "tanuki"
            ]
          }
        },
        "type": "feat"
      },
