    {
      "fileName": "gnome-weapon-familiarity.json",
      "id": "3zr5Gt5LgHsMNpSO",
      "name": "Gnome Weapon Familiarity",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "3zr5Gt5LgHsMNpSO",
        "folder": "iCmY7YHz0Y1zDoPb",
