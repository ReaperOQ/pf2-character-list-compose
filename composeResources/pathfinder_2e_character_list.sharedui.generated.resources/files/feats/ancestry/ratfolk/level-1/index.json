    {
      "fileName": "warren-navigator.json",
      "id": "9Orkgjgfx8AILuqD",
      "name": "Warren Navigator",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "9Orkgjgfx8AILuqD",
        "folder": "lSy9DEaCT6ETIExr",
