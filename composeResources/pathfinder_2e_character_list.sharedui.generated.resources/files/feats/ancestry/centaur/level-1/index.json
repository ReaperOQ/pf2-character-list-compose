    {
      "fileName": "centaur-weapon-familiarity.json",
      "id": "dz3z1DLxV6GYH45Y",
      "name": "Centaur Weapon Familiarity",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "dz3z1DLxV6GYH45Y",
        "folder": "Cic6ZlYRhKDqmNy7",
