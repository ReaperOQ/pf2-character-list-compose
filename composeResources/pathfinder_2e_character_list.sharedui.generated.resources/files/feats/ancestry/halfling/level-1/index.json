        "system": {
          "actionType": {
            "value": "passive"
          },
          "actions": {
            "value": null
          },
          "category": "ancestry",
          "description": {
            "value": "<p>Whether keeping your balance or climbing, your feet easily find purchase. If you roll a success on an Acrobatics check to @UUID[Compendium.pf2e.actionspf2e.Item.Balance] or an Athletics check to @UUID[Compendium.pf2e.actionspf2e.Item.Climb], you get a critical success instead. You're not @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] when you attempt to Balance or Climb.</p>"
          },
          "level": {
            "value": 1
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Player Core"
          },
          "rules": [
            {
