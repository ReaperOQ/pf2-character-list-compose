    {
      "fileName": "prairie-rider.json",
      "id": "A9HQ2bMAge2aGgWx",
      "name": "Prairie Rider",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "A9HQ2bMAge2aGgWx",
        "folder": "MlNGMEeedSIgPZTb",
