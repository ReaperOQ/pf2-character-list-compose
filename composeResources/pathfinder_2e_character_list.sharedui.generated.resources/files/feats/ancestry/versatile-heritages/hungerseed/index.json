    {
      "fileName": "storming-gaze.json",
      "id": "D3usONRMsGZ7mWs1",
      "name": "Storming Gaze",
      "img": "icons/sundries/books/book-red-exclamation.webp",
      "type": "feat",
      "data": {
        "_id": "D3usONRMsGZ7mWs1",
        "folder": "UduQItW59597Fjgy",
        "img": "icons/sundries/books/book-red-exclamation.webp",
        "name": "Storming Gaze",
        "system": {
          "actionType": {
            "value": "action"
          },
          "actions": {
            "value": 2
          },
          "category": "ancestry",
          "description": {
            "value": "<p>You can open or energize a notable third eye on your forehead to strike with storming power. You deal @Damage[(ceil(@actor.level/2))d4[@item.flags.system.rulesSelections.stormingGaze]|options:area-damage]{3d4 electricity or 3d4 sonic damage} in a @Template[type:cone|distance:15]; Storming Gaze gains this trait. Each creature in the area must attempt a @Check[reflex|against:class-spell|basic] saving throw against the higher of your class DC or spell DC. You can't use this ability again for [[/r 1d4 #Recharge Storming Gaze]]{1d4 rounds}.</p>\n<p>At 7th level and every 2 levels thereafter, the damage increases by 1d4.</p>"
          },
          "level": {
            "value": 5
          },
          "prerequisites": {
            "value": []
          },
          "publication": {
            "license": "ORC",
            "remaster": true,
            "title": "Pathfinder Lost Omens Tian Xia Character Guide"
          },
          "rules": [
